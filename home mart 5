<script>
  // Local reactive micro-state ensuring complete preview fidelity
  const storeItemsState = {
    'p1': 1, // Honeycrisp Apples (₹180)
    'p2': 1, // Baby Palak / Spinach (₹30) -> Total 2 items • ₹210
  };

  const storeProductPrices = {
    'p1': { name: 'Honeycrisp Apples', price: 180 },
    'p2': { name: 'Baby Palak / Spinach', price: 30 },
    'p3': { name: 'Ripe Hass Avocados', price: 190 },
    'p4': { name: 'Hybrid Roma Tomatoes', price: 38 },
    'p5': { name: 'Cavendish Bananas', price: 45 },
    'p6': { name: 'Bell Peppers Trio', price: 75 },
    'p7': { name: 'Daawat Rozana Basmati Rice', price: 85 },
    'p8': { name: 'Tata Sampann Toor Dal', price: 165 },
    'p9': { name: 'Aashirvaad Shudh Chakki Atta', price: 245 },
    'p10': { name: 'Nataraj 621 Pencils', price: 60 },
    'p11': { name: 'Pampers Diaper Pants', price: 349 }
  };

  function updateItemStepperDOM(slot, id, qty) {
    if (!slot) return;
    if (qty > 0) {
      slot.innerHTML = `
        <div class="flex items-center bg-primary text-on-primary rounded-lg h-8 px-1.5 shadow-xs">
          <button type="button" onclick="changeStoreItemQty('${id}', -1)" class="w-6 h-6 flex items-center justify-center font-bold text-sm active:scale-90">-</button>
          <span class="px-1 text-xs font-bold font-unit-rate">${qty}</span>
          <button type="button" onclick="changeStoreItemQty('${id}', 1)" class="w-6 h-6 flex items-center justify-center font-bold text-sm active:scale-90">+</button>
        </div>
      `;
    } else {
      const prodName = storeProductPrices[id]?.name || 'Item';
      const prodPrice = storeProductPrices[id]?.price || 0;
      slot.innerHTML = `
        <button type="button" onclick="handleStoreAdd(this, '${id}', '${prodName}', ${prodPrice})" class="h-8 px-3 rounded-lg bg-surface-container-high hover:bg-primary hover:text-on-primary text-primary font-label-sm text-label-sm font-bold flex items-center justify-center transition-all shadow-xs active:scale-95">
          + Add
        </button>
      `;
    }
  }

  function renderAllItemSteppers() {
    document.querySelectorAll('.item-action-slot').forEach(slot => {
      const id = slot.dataset.id;
      const qty = storeItemsState[id] || 0;
      updateItemStepperDOM(slot, id, qty);
    });
    updateFloatingPreviewBar();
  }

  function handleStoreAdd(buttonEl, id, name, price) {
    storeItemsState[id] = (storeItemsState[id] || 0) + 1;
    const slot = buttonEl.closest('.item-action-slot');
    if (slot) updateItemStepperDOM(slot, id, storeItemsState[id]);
    updateFloatingPreviewBar();
    if (typeof window.changeQty === 'function') {
      window.cart[id] = storeItemsState[id];
      window.updateCartDisplay();
    }
  }

  function changeStoreItemQty(id, delta) {
    const next = (storeItemsState[id] || 0) + delta;
    if (next <= 0) {
      delete storeItemsState[id];
    } else {
      storeItemsState[id] = next;
    }
    const slot = document.querySelector(`.item-action-slot[data-id="${id}"]`);
    if (slot) updateItemStepperDOM(slot, id, storeItemsState[id] || 0);
    updateFloatingPreviewBar();
    if (typeof window.changeQty === 'function') {
      if (next <= 0) {
        delete window.cart[id];
      } else {
        window.cart[id] = next;
      }
      window.updateCartDisplay();
    }
  }

  function updateFloatingPreviewBar() {
    let count = 0;
    let total = 0;
    for (const [id, qty] of Object.entries(storeItemsState)) {
      if (qty > 0 && storeProductPrices[id]) {
        count += qty;
        total += storeProductPrices[id].price * qty;
      }
    }

    const countBadge = document.getElementById('live-cart-count');
    const totalDisplay = document.getElementById('live-cart-total');
    const tray = document.getElementById('preview-floating-tray-container');

    if (countBadge) countBadge.innerText = count;
    if (totalDisplay) {
      totalDisplay.innerText = `${count} ${count === 1 ? 'item' : 'items'} • ₹${total}`;
    }

    if (tray) {
      if (count > 0) {
        tray.classList.remove('hidden');
      } else {
        tray.classList.add('hidden');
      }
    }
  }

  function selectCategoryTag(categoryName, btn) {
    document.querySelectorAll('.category-pill').forEach(p => {
      p.className = 'category-pill shrink-0 h-8 px-3.5 rounded-full bg-surface-container-lowest text-on-surface-variant hover:text-on-surface font-label-md text-label-md font-medium shadow-xs transition-transform active:scale-95';
    });
    if (btn) {
      btn.className = 'category-pill shrink-0 h-8 px-3.5 rounded-full bg-primary text-on-primary font-label-md text-label-md font-bold shadow-xs transition-transform active:scale-95';
    }

    const blocks = document.querySelectorAll('.category-block');
    blocks.forEach(block => {
      const cats = block.dataset.category || '';
      if (categoryName === 'All Items' || cats.includes(categoryName)) {
        block.classList.remove('hidden');
      } else {
        block.classList.add('hidden');
      }
    });

    const searchInput = document.getElementById('store-search-field');
    if (searchInput) searchInput.value = '';
    const clearBtn = document.getElementById('clear-search-btn');
    if (clearBtn) clearBtn.classList.add('hidden');
    document.getElementById('search-empty-state')?.classList.add('hidden');
  }

  function filterByDirectTag(catName) {
    const pills = document.querySelectorAll('.category-pill');
    for (const p of pills) {
      if (p.textContent.includes(catName)) {
        selectCategoryTag(catName, p);
        p.scrollIntoView({ behavior: 'smooth', inline: 'center' });
        break;
      }
    }
  }

  function handleInstantSearch(val) {
    const query = val.trim().toLowerCase();
    const clearBtn = document.getElementById('clear-search-btn');
    if (clearBtn) {
      if (query.length > 0) {
        clearBtn.classList.remove('hidden');
        clearBtn.classList.add('flex');
      } else {
        clearBtn.classList.add('hidden');
        clearBtn.classList.remove('flex');
      }
    }

    const articles = document.querySelectorAll('.product-item');
    let visibleCount = 0;

    articles.forEach(art => {
      const title = (art.dataset.title || '').toLowerCase();
      const cat = (art.dataset.cat || '').toLowerCase();
      if (!query || title.includes(query) || cat.includes(query)) {
        art.classList.remove('hidden');
        visibleCount++;
      } else {
        art.classList.add('hidden');
      }
    });

    document.querySelectorAll('.category-block').forEach(block => {
      const visibleChildren = block.querySelectorAll('.product-item:not(.hidden)').length;
      if (visibleChildren === 0) {
        block.classList.add('hidden');
      } else {
        block.classList.remove('hidden');
      }
    });

    const empty = document.getElementById('search-empty-state');
    if (empty) {
      if (visibleCount === 0) {
        empty.classList.remove('hidden');
        empty.classList.add('flex');
      } else {
        empty.classList.add('hidden');
        empty.classList.remove('flex');
      }
    }
  }

  function clearSearchInput() {
    const field = document.getElementById('store-search-field');
    if (field) {
      field.value = '';
      handleInstantSearch('');
    }
    const firstPill = document.querySelector('.category-pill');
    if (firstPill) selectCategoryTag('All Items', firstPill);
  }

  // Initialize interactive steppers on load
  document.addEventListener('DOMContentLoaded', () => {
    renderAllItemSteppers();
  });
  renderAllItemSteppers();
</script></main>
