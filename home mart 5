            <div class="relative w-full aspect-square rounded-xl bg-surface-container overflow-hidden mb-2">
              <img class="w-full h-full object-cover" src="${p.img}" alt="${p.name}"/>
              ${p.tag ? `<span class="absolute top-1.5 left-1.5 bg-secondary-container text-on-secondary-container font-unit-rate text-[10px] font-bold px-1.5 py-0.5 rounded-md">${p.tag}</span>` : ''}
            </div>
            <div class="flex flex-col flex-1 justify-between">
              <div>
                <span class="font-unit-rate text-[11px] text-outline block leading-none mb-1">${p.unit}</span>
                <h4 class="font-title-sm text-[13px] leading-tight text-on-surface font-bold line-clamp-2">${p.name}</h4>
              </div>
              <div class="mt-2.5 flex items-center justify-between pt-1">
                <div class="flex flex-col">
                  <span class="font-price-display text-price-display text-primary leading-none">₹${p.price}</span>
                  <span class="font-unit-rate text-[10px] text-outline line-through">₹${p.mrp}</span>
                </div>
                ${qty > 0 ? `
                  <div class="flex items-center bg-primary text-on-primary rounded-lg h-8 px-1.5 shadow-sm">
                    <button onclick="changeQty('${p.id}', -1)" class="w-6 h-6 flex items-center justify-center font-bold text-sm">-</button>
                    <span class="px-1 text-xs font-bold">${qty}</span>
                    <button onclick="changeQty('${p.id}', 1)" class="w-6 h-6 flex items-center justify-center font-bold text-sm">+</button>
                  </div>
                ` : `
                  <button onclick="changeQty('${p.id}', 1)" class="h-8 px-3 rounded-lg bg-surface-container-high hover:bg-primary hover:text-on-primary text-primary font-label-sm text-label-sm font-bold flex items-center justify-center transition-all shadow-sm active:scale-95">
                    + Add
                  </button>
                `}
              </div>
            </div>
          </div>
        `;
      }).join('');

      const countEl = document.getElementById('catalog-count');
      if (countEl) countEl.innerText = `(${items.length} items)`;
    }

    function changeQty(productId, delta) {
      const current = cart[productId] || 0;
      const next = current + delta;
      if (next <= 0) {
        delete cart[productId];
      } else {
        cart[productId] = next;
      }
      renderCatalog(getActiveFilterItems());
      updateCartDisplay();
    }

    function getActiveFilterItems() {
      const query = (document.getElementById('search-input')?.value || '').toLowerCase();
      return catalogProducts.filter(p => {
        const matchesCategory = currentCategory === 'All' || p.category === currentCategory;
        const matchesQuery = p.name.toLowerCase().includes(query) || p.unit.toLowerCase().includes(query);
        return matchesCategory && matchesQuery;
      });
    }

    function filterCategory(category, buttonEl) {
      currentCategory = category;
      const pills = document.querySelectorAll('#category-pills button');
      pills.forEach(b => {
        b.className = "shrink-0 px-3.5 py-1.5 rounded-full bg-surface-container text-on-surface-variant hover:bg-surface-container-high font-label-md text-label-md font-medium transition-colors";
      });
      if (buttonEl) {
        buttonEl.className = "shrink-0 px-3.5 py-1.5 rounded-full bg-primary text-on-primary font-label-md text-label-md font-bold shadow-sm transition-transform active:scale-95";
      }
      renderCatalog(getActiveFilterItems());
    }

    function filterCatalog(query) {
      renderCatalog(getActiveFilterItems());
    }

    function resetFilters() {
      currentCategory = "All";
      const searchInput = document.getElementById('search-input');
      if (searchInput) searchInput.value = '';
      const pills = document.querySelectorAll('#category-pills button');
      if (pills.length > 0) filterCategory('All', pills[0]);
    }

    // Basket & Calculation
    function updateCartDisplay() {
      let totalCount = 0;
      let totalAmount = 0;
      const basketItemsContainer = document.getElementById('basket-items-list');
      let basketHtml = '';

      const itemsInCart = [];

      for (const [id, qty] of Object.entries(cart)) {
        const prod = catalogProducts.find(p => p.id === id);
        if (prod && qty > 0) {
          totalCount += qty;
          totalAmount += prod.price * qty;
          itemsInCart.push({ ...prod, qty });

          basketHtml += `
            <div class="bg-surface-container-lowest rounded-2xl p-3 flex items-center justify-between border border-surface-container">
              <div class="flex items-center gap-3">
                <img src="${prod.img}" class="w-12 h-12 object-cover rounded-xl bg-surface-container" alt="${prod.name}"/>
                <div>
                  <h4 class="font-title-sm text-xs font-bold text-on-surface line-clamp-1">${prod.name}</h4>
                  <p class="font-unit-rate text-[11px] text-outline">${prod.unit} • ₹${prod.price} each</p>
                </div>
              </div>
              <div class="flex items-center gap-3">
                <div class="flex items-center bg-surface-container rounded-lg h-7 px-1">
                  <button onclick="changeQty('${prod.id}', -1)" class="w-5 h-5 flex items-center justify-center font-bold text-xs">-</button>
                  <span class="px-2 text-xs font-bold">${qty}</span>
                  <button onclick="changeQty('${prod.id}', 1)" class="w-5 h-5 flex items-center justify-center font-bold text-xs">+</button>
                </div>
                <span class="font-price-display text-sm font-bold text-primary min-w-[40px] text-right">₹${prod.price * qty}</span>
              </div>
            </div>
          `;
        }
      }

      if (basketItemsContainer) {
        basketItemsContainer.innerHTML = basketHtml || '<div class="p-6 text-center text-outline">Your basket is empty. Browse fresh picks!</div>';
      }

      // Discount calculation: ₹50 off if > ₹300
      let discount = totalAmount >= 300 ? 50 : 0;
      let payable = Math.max(0, totalAmount - discount);

      // Update counters
      const countBadge = document.getElementById('cart-item-count');
      const navBadge = document.getElementById('nav-cart-badge');
      const priceDisplay = document.getElementById('cart-total-price');
      const subtotalEl = document.getElementById('bill-subtotal');
      const discountEl = document.getElementById('bill-discount');
      const grandTotalEl = document.getElementById('bill-grand-total');
      const basketSubtitle = document.getElementById('basket-subtitle');
      const checkoutAmount = document.getElementById('checkout-amount');

      if (countBadge) countBadge.innerText = totalCount;
      if (navBadge) navBadge.innerText = totalCount;
      if (priceDisplay) priceDisplay.innerText = '₹' + payable;
      if (subtotalEl) subtotalEl.innerText = '₹' + totalAmount;
      if (discountEl) discountEl.innerText = '-₹' + discount;
      if (grandTotalEl) grandTotalEl.innerText = '₹' + payable;
      if (basketSubtitle) basketSubtitle.innerText = `${totalCount} items ready for delivery`;
      if (checkoutAmount) checkoutAmount.innerText = '₹' + payable;

      // Update UPI link & QR Code
      const qrImg = document.getElementById('checkout-qr-img');
      const upiLink = `upi://pay?pa=${encodeURIComponent(appSettings.storeUPI)}&pn=HomeMartFresh&am=${payable}&cu=INR`;
      const upiIntentBtn = document.getElementById('btn-upi-app-intent');
      if (upiIntentBtn) upiIntentBtn.href = upiLink;
      if (qrImg) {
        qrImg.src = `https://api.qrserver.com/v1/create-qr-code/?size=180x180&data=${encodeURIComponent(upiLink)}`;
      }

      // Populate Receipt items
      populateReceiptSummary(itemsInCart, payable);

      // Toggle floating cart tray visibility
      const floatingWrapper = document.getElementById('floating-cart-wrapper');
      if (floatingWrapper) {
        const isMarketTab = !document.getElementById('view-market')?.classList.contains('hidden');
        if (totalCount > 0 && isMarketTab) {
          floatingWrapper.classList.remove('hidden');
        } else {
          floatingWrapper.classList.add('hidden');
        }
      }
    }

    function populateReceiptSummary(items, paidAmount) {
      const container = document.getElementById('receipt-items-container');
      const totalPaidEl = document.getElementById('receipt-total-paid');
      if (!container) return;

      if (items.length === 0) {
        items = [
          { name: "Honeycrisp Apples", unit: "1 kg", qty: 1, price: 180 },
          { name: "Baby Palak / Spinach", unit: "250g pack", qty: 1, price: 30 },
          { name: "Ripe Hass Avocados", unit: "Pack of 2", qty: 1, price: 190 },
          { name: "Hybrid Roma Tomatoes", unit: "1 kg", qty: 1, price: 38 }
        ];
        paidAmount = 388; // 438 - 50 discount
      }

      container.innerHTML = items.map(it => `
        <div class="flex justify-between items-center text-on-surface">
          <div class="flex items-center gap-1.5">
            <span class="w-1.5 h-1.5 rounded-full bg-primary"></span>
            <span>${it.name} <span class="text-outline text-xs">(${it.unit}) × ${it.qty}</span></span>
          </div>
          <span class="font-semibold">₹${it.price * it.qty}</span>
        </div>
      `).join('');

      if (totalPaidEl) totalPaidEl.innerText = `₹${paidAmount}`;
    }

    function clearBasket() {
      cart = {};
      renderCatalog(getActiveFilterItems());
      updateCartDisplay();
    }

    // Tab Navigation Routing
    function navigateToTab(tabName) {
      const views = {
        'market': document.getElementById('view-market'),
        'my-basket': document.getElementById('view-basket'),
        'checkout': document.getElementById('view-checkout'),
        'orders-and-returns': document.getElementById('view-receipt')
      };

      // Hide all views
      for (const key in views) {
        if (views[key]) {
          views[key].classList.add('hidden');
          views[key].classList.remove('block');
        }
      }

      // Show selected
      if (views[tabName]) {
        views[tabName].classList.remove('hidden');
        views[tabName].classList.add('block');
      }

      // Update Nav Buttons
      document.querySelectorAll('#bottom-tabs .tab-btn').forEach(btn => {
        if (btn.dataset.tab === tabName) {
          btn.classList.add('text-primary', 'font-bold');
          btn.classList.remove('text-on-surface-variant');
        } else {
          btn.classList.remove('text-primary', 'font-bold');
          btn.classList.add('text-on-surface-variant');
        }
      });

      // Floating Cart Visibility
      const floatingWrapper = document.getElementById('floating-cart-wrapper');
      if (floatingWrapper) {
        const total = Object.values(cart).reduce((a, b) => a + b, 0);
        if (tabName === 'market' && total > 0) {
          floatingWrapper.classList.remove('hidden');
        } else {
          floatingWrapper.classList.add('hidden');
        }
      }

      window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    // Order Success Trigger
    function confirmOrderSuccess() {
      alert('🎉 Payment Recorded! Order #HM-8842 Confirmed. Our rider is rolling out now.');
      navigateToTab('orders-and-returns');
    }

    function copyStoreUPI() {
      navigator.clipboard.writeText(appSettings.storeUPI).then(() => {
        alert(`📋 Copied official UPI ID: ${appSettings.storeUPI}`);
      }).catch(() => {
        alert(`UPI ID: ${appSettings.storeUPI}`);
      });
    }

    // Modal Handlers
    function openModal(id) {
      const modal = document.getElementById(id);
      if (!modal) return;
      modal.classList.remove('opacity-0', 'pointer-events-none');
      modal.classList.add('opacity-100', 'pointer-events-auto');
      const panel = modal.firstElementChild;
      if (panel) {
        panel.classList.remove('translate-y-8', 'scale-95');
        panel.classList.add('translate-y-0', 'scale-100');
      }
    }

    function closeModal(id) {
      const modal = document.getElementById(id);
      if (!modal) return;
      modal.classList.add('opacity-0', 'pointer-events-none');
      modal.classList.remove('opacity-100', 'pointer-events-auto');
      const panel = modal.firstElementChild;
      if (panel) {
        panel.classList.add('translate-y-8', 'scale-95');
        panel.classList.remove('translate-y-0', 'scale-100');
      }
      const err = document.getElementById('pin-error');
      if (err) err.classList.add('hidden');
      const pin = document.getElementById('admin-pin-field');
      if (pin) pin.value = '';
    }

    function verifyAdminPin() {
      const pin = document.getElementById('admin-pin-field');
      const err = document.getElementById('pin-error');
      if (pin && pin.value === '7006') {
        closeModal('admin-modal');
        // Pre-fill inputs with current settings
        document.getElementById('input-rider-name').value = appSettings.riderName;
        document.getElementById('input-rider-phone').value = appSettings.riderPhone;
        document.getElementById('input-hub-name').value = appSettings.hubName;
        document.getElementById('input-eta').value = appSettings.deliveryETA;
        document.getElementById('input-location-tag').value = appSettings.locationTag;
        document.getElementById('input-store-wa').value = appSettings.storeWhatsApp;
        document.getElementById('input-store-upi').value = appSettings.storeUPI;
        document.getElementById('input-flash-banner').value = appSettings.flashBanner;

        openModal('admin-panel-modal');
      } else if (err) {
        err.classList.remove('hidden');
        if (pin) pin.value = '';
      }
    }

    // Admin Subtab Switcher
    function switchAdminSubTab(tab) {
      const tabs = ['dispatch', 'returns', 'products'];
      tabs.forEach(t => {
        const btn = document.getElementById(`admin-tab-btn-${t}`);
        const view = document.getElementById(`admin-subtab-${t}`);
        if (t === tab) {
          btn.className = "py-2 px-1 rounded-lg text-xs font-bold transition-all bg-primary text-on-primary shadow-xs";
          if (view) view.classList.remove('hidden');
        } else {
          btn.className = "py-2 px-1 rounded-lg text-xs font-bold transition-all text-on-surface-variant hover:text-on-surface";
          if (view) view.classList.add('hidden');
        }
      });
    }

    function populateAdminRates() {
      const container = document.getElementById('admin-product-rates-list');
      if (!container) return;
      container.innerHTML = catalogProducts.map(p => `
        <div class="flex items-center justify-between p-2 rounded-lg bg-surface-container-lowest border border-surface-container">
          <div class="truncate max-w-[180px]">
            <p class="font-bold text-on-surface truncate">${p.name}</p>
            <span class="text-[10px] text-outline">${p.unit} • ${p.category}</span>
          </div>
          <div class="flex items-center gap-2">
            <span class="font-bold text-primary">₹${p.price}</span>
            <span class="text-[10px] line-through text-outline">₹${p.mrp}</span>
          </div>
        </div>
      `).join('');
    }

    // Customer Return & Refund Calculations
    function calcRefundAmount() {
      const checkboxes = document.querySelectorAll('.return-item-check:checked');
      let total = 0;
      checkboxes.forEach(cb => {
        total += parseInt(cb.value, 10);
      });
      const display = document.getElementById('refund-calc-display');
      if (display) display.innerText = '₹' + total;
      return total;
    }

    function submitCustomerReturn() {
      const checkboxes = document.querySelectorAll('.return-item-check:checked');
      if (checkboxes.length === 0) {
        alert('⚠️ Please select at least one item from your order to return.');
        return;
      }

      const totalRefund = calcRefundAmount();
      const reason = document.getElementById('return-reason')?.value || 'Damaged / Not Fresh';
      const customerUpi = document.getElementById('return-customer-upi')?.value.trim() || 'customer@upi';

      const selectedItems = Array.from(checkboxes).map(cb => cb.dataset.item).join(', ');

      // Create WhatsApp message string
      const waText = encodeURIComponent(
        `*HOME MART RETURN & REFUND REQUEST*\n` +
        `--------------------------------\n` +
        `*Order #:* HM-8842\n` +
        `*Items to Return:* ${selectedItems}\n` +
        `*Reason:* ${reason}\n` +
        `*Refund Amount:* ₹${totalRefund}\n` +
        `*Customer UPI Reversal ID:* ${customerUpi}\n` +
        `*Delivery Hub:* ${appSettings.hubName}\n` +
        `*Assigned Rider:* ${appSettings.riderName}\n\n` +
        `Please approve and process instant reversal per 100% Freshness Guarantee.`
      );

      // Add request to Admin Returns Queue dynamically
      const queue = document.getElementById('admin-returns-queue');
      if (queue) {
        const newCard = document.createElement('div');
        newCard.className = "p-3.5 rounded-2xl bg-surface-container-lowest border-2 border-error/30 shadow-xs space-y-2";
        newCard.innerHTML = `
          <div class="flex items-center justify-between text-xs">
            <span class="font-bold text-on-surface">Order #HM-8842 (New Request)</span>
            <span class="px-2 py-0.5 rounded-full bg-error-container text-on-error-container font-unit-rate text-[10px] font-bold">New Return</span>
          </div>
          <div class="text-xs space-y-1">
            <p class="text-on-surface-variant"><strong class="text-on-surface">Item(s):</strong> ${selectedItems}</p>
            <p class="text-on-surface-variant"><strong class="text-on-surface">Reason:</strong> ${reason}</p>
            <p class="text-on-surface-variant"><strong class="text-on-surface">Customer UPI:</strong> <code class="bg-surface-container px-1 rounded text-primary font-bold">${customerUpi}</code></p>
            <p class="text-xs font-bold text-error">Refund Due: ₹${totalRefund}</p>
          </div>
          <div class="grid grid-cols-2 gap-2 pt-1">
            <a href="upi://pay?pa=${encodeURIComponent(customerUpi)}&pn=HomeMartRefund&am=${totalRefund}&cu=INR" class="py-2 px-2.5 rounded-xl bg-primary text-white text-[11px] font-bold flex items-center justify-center gap-1 hover:bg-primary-container transition-colors">
              <i class="fa-solid fa-bolt"></i> 1-Tap UPI Reversal
            </a>
            <button onclick="markRefundApproved(this, '${customerUpi}', ${totalRefund})" class="py-2 px-2.5 rounded-xl bg-surface-container text-on-surface text-[11px] font-semibold hover:bg-surface-container-high transition-colors">
              Mark Reversed
            </button>
          </div>
        `;
        queue.prepend(newCard);
      }

      // Redirect to WhatsApp Desk
      const waUrl = `https://wa.me/91${appSettings.storeWhatsApp}?text=${waText}`;
      window.open(waUrl, '_blank');

      alert(`✅ Return Request for ₹${totalRefund} logged! Opening WhatsApp Order Desk (+91 ${appSettings.storeWhatsApp}) with pre-formatted return ticket.`);
    }

    function markRefundApproved(btn, upiId, amt) {
      const card = btn.closest('.rounded-2xl');
      if (card) {
        card.classList.remove('border-error/30');
        card.classList.add('bg-emerald-50', 'border-emerald-200');
        card.innerHTML = `
          <div class="flex items-center gap-2 text-emerald-800 text-xs font-bold">
            <span class="material-symbols-outlined text-[18px]">verified</span>
            <span>Refund of ₹${amt} Reversed to ${upiId} (100% Guaranteed)</span>
          </div>
          <p class="text-[11px] text-emerald-700 mt-1 font-unit-rate">Reversal ID: REF-${Date.now().toString().slice(-6)} • Store Ledger Updated</p>
        `;
      }
    }
  </script>
</body></html>
