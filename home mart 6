} (${item.unit}) x ${qty} = ₹${item.price * qty}\n`; } } if (!itemList) itemList = "• Grocery Harvest Basket = ₹" + total + "\n"; const msg = `🛒 *NEW ORDER: HOME MART FRESH*\n` + `Order ID: *#${orderId}*\n\n` + `👤 *Customer:* ${name}\n` + `📞 *Phone:* ${phone}\n` + `📍 *Delivery Address:* ${address}\n\n` + `📦 *Order Items:*\n${itemList}\n` + `💰 *Total Amount:* ₹${total}\n` + `⚡ *Official UPI:* ${STORE_UPI}\n\n` + `_Please confirm dispatch!_`; document.getElementById('receiptOrderId').innerText = `Order #${orderId}`; window.open(`https://api.whatsapp.com/send?phone=${STORE_WHATSAPP}&text=${encodeURIComponent(msg)}`, '_blank'); switchView('receipt'); } function promptAdminLogin() { const p = prompt("Enter Store Admin PIN:"); if (p === ADMIN_PIN) { alert("Admin Mode Verified: Fleet Desk, CRM and Rates active."); } else if (p !== null) { alert("Incorrect PIN."); } } renderButtons(); updateCartTotals(); </script> </body> </html> ``` --- 
