    function saveRiderToFleet() {
      const name = document.getElementById('riderNameInput').value.trim();
      const phone = document.getElementById('riderPhoneInput').value.trim().replace(/\D/g, '');
      const vehicle = document.getElementById('riderVehicleInput').value.trim() || 'Electric EV Hub #4';
      const rating = document.getElementById('riderRatingInput').value.trim() || '4.9★';
      const setCurrent = document.getElementById('riderSetCurrent').checked;
      const editId = document.getElementById('editRiderId').value.trim();

      if (!name || phone.length < 10) {
        alert("Please provide rider name and valid 10-digit mobile number.");
        return;
      }

      if (editId) {
        const idx = riderFleet.findIndex(r => r.id === editId);
        if (idx !== -1) {
          riderFleet[idx].name = name;
          riderFleet[idx].phone = phone;
          riderFleet[idx].vehicle = vehicle;
          riderFleet[idx].rating = rating;
          if (setCurrent) {
            riderFleet.forEach(r => r.isCurrent = false);
            riderFleet[idx].isCurrent = true;
          }
        }
      } else {
        const newRider = {
          id: 'r_' + Date.now(),
          name,
          phone,
          vehicle,
          rating,
          isCurrent: setCurrent
        };
        if (setCurrent) {
          riderFleet.forEach(r => r.isCurrent = false);
        }
        riderFleet.unshift(newRider);
      }

      if (!riderFleet.some(r => r.isCurrent)) {
        riderFleet[0].isCurrent = true;
      }

      saveFleet();
      toggleRiderForm(false);
      alert(`Rider "${name}" saved to fleet successfully!`);
    }

    function editRider(id) {
      const rider = riderFleet.find(r => r.id === id);
      if (!rider) return;

      toggleRiderForm(true);
      document.getElementById('editRiderId').value = rider.id;
      document.getElementById('riderFormTitle').innerText = `Edit Rider: ${rider.name}`;
      document.getElementById('riderNameInput').value = rider.name;
      document.getElementById('riderPhoneInput').value = rider.phone;
      document.getElementById('riderVehicleInput').value = rider.vehicle;
      document.getElementById('riderRatingInput').value = rider.rating;
      document.getElementById('riderSetCurrent').checked = rider.isCurrent;
    }

    function setActiveRider(id) {
      riderFleet.forEach(r => r.isCurrent = (r.id === id));
      saveFleet();
    }

    function deleteRider(id) {
      if (riderFleet.length <= 1) {
