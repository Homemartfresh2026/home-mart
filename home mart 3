      document.getElementById('adminTopBanner').classList.add('hidden');
    }

    function renderNotifications() {
      const activeList = notifications.filter(n => n.active !== false);
      const badge = document.getElementById('unreadNotifBadge');
      if (badge) badge.innerText = activeList.length;

      const bannerItem = activeList.find(n => n.isBanner);
      const bannerEl = document.getElementById('adminTopBanner');
      if (bannerItem && bannerEl) {
        bannerEl.classList.remove('hidden');
        document.getElementById('bannerText').innerText = `${bannerItem.title} — ${bannerItem.desc}`;
      } else if (bannerEl) {
        bannerEl.classList.add('hidden');
      }

      const custList = document.getElementById('customerNotifList');
      if (custList) {
        custList.innerHTML = activeList.map(n => `
          <div class="p-3 rounded-2xl border border-emerald-100 bg-emerald-50/60">
            <h4 class="font-bold text-xs text-slate-900">${n.title}</h4>
            <p class="text-[11px] text-slate-600 mt-0.5">${n.desc}</p>
          </div>
        `).join('');
      }
    }

    function openCustomerNotificationsModal() {
      renderNotifications();
      document.getElementById('customerNotifModal').classList.remove('hidden');
    }

    function closeCustomerNotificationsModal() {
      document.getElementById('customerNotifModal').classList.add('hidden');
    }

    function publishBroadcast() {
      const title = document.getElementById('notifTitle').value.trim();
      const desc = document.getElementById('notifMsg').value.trim();
      const isBanner = document.getElementById('notifIsBanner').checked;

      if (!title || !desc) {
        alert("Please enter title and message.");
        return;
      }

      if (isBanner) notifications.forEach(n => n.isBanner = false);

      notifications.unshift({
        id: Date.now(),
        title,
        desc,
        isBanner,
        active: true
      });

      saveNotifications();
      document.getElementById('notifTitle').value = '';
      document.getElementById('notifMsg').value = '';
      alert(`Broadcast "${title}" published live!`);
    }

    function renderAdminNotifications() {
      const list = document.getElementById('adminNotificationsList');
      if (!list) return;
      list.innerHTML = notifications.map(n => `
        <div class="p-2.5 rounded-xl border border-slate-100 bg-slate-50 flex items-center justify-between text-xs">
          <div>
            <div class="font-bold text-slate-900">${n.title}</div>
            <div class="text-[10px] text-slate-500">${n.isBanner ? '📌 Top Banner' : 'General Notice'}</div>
          </div>
          <button onclick="deleteNotification(${n.id})" class="text-red-500 p-1">
            <i class="fa-solid fa-trash-can"></i>
          </button>
        </div>
      `).join('');
    }

    function deleteNotification(id) {
      notifications = notifications.filter(n => n.id !== id);
      saveNotifications();
    }

    // App Initialization
    window.addEventListener('DOMContentLoaded', () => {
      const urlParams = new URLSearchParams(window.location.search);
      const trackId = urlParams.get('track') || urlParams.get('order');
      if (trackId) {
        currentOrderId = trackId;
        document.getElementById('receiptOrderId').innerText = `Order #${trackId}`;
        switchView('receipt');
      } else {
        renderStorefront();
        renderNotifications();
        updateCartCounts();
      }
      applyActiveRiderToUI();
      lookupCustomerByPhone();
    });
  </script>
</body>
</html>
