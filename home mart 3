    function submitReturnRequest() {
      const checkedBoxes = Array.from(document.querySelectorAll('.return-checkbox:checked'));
      if (checkedBoxes.length === 0) {
        alert("Please select at least one item to return.");
        return;
      }
      const reason = document.getElementById('returnReason').value;
      const upi = document.getElementById('custRefundUpi').value.trim();
      if (!upi) {
        alert("Please provide your UPI ID for instant reversal.");
        return;
      }
      let sum = 0;
      let itemsList = "";
      checkedBoxes.forEach(cb => {
        sum += parseFloat(cb.value);
        itemsList += `• ${cb.dataset.name} (₹${cb.value})\n`;
      });

      const ticketId = "RT-" + Math.floor(1000 + Math.random() * 9000);
      const text = `🔄 *HOME MART RETURN & INSTANT UPI REFUND REQUEST*\n` +
                   `Return Ticket: *#${ticketId}*\n` +
                   `Order Reference: *#${currentOrderId}*\n\n` +
                   `📦 *Items to Return:*\n${itemsList}\n` +
                   `⚠️ *Reason:* ${reason}\n` +
