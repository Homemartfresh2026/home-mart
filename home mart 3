<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>Home Mart FRESH — Online Grocery, Fleet & Customer Loyalty</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <style>
    body { font-family: 'Plus Jakarta Sans', sans-serif; background-color: #faf8ff; -webkit-tap-highlight-color: transparent; }
    .no-scrollbar::-webkit-scrollbar { display: none; }
    .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
  </style>
</head>
<body class="text-slate-800 pb-24 select-none min-h-screen">

  <!-- ================= TOP FLASH ANNOUNCEMENT BAR ================= -->
  <div id="adminTopBanner" class="bg-gradient-to-r from-amber-500 via-orange-500 to-amber-600 text-white text-[11px] font-bold px-4 py-2 flex items-center justify-between shadow-xs">
    <div class="flex items-center gap-2 max-w-md mx-auto w-full">
      <span class="text-xs">🎉</span>
      <span id="bannerText" class="truncate flex-1">Flash Discount: ₹50 OFF Orders Over ₹300! Direct Farm Harvest.</span>
      <button onclick="dismissBanner()" class="text-white/80 hover:text-white text-xs pl-2">
        <i class="fa-solid fa-xmark"></i>
      </button>
    </div>
  </div>

  <!-- ================= TOP APP BAR ================= -->
  <header class="sticky top-0 z-40 bg-white/95 backdrop-blur border-b border-slate-100 px-4 py-3 shadow-xs">
    <div class="flex items-center justify-between max-w-md mx-auto">
      <div class="flex items-center gap-2.5">
        <div class="w-9 h-9 rounded-xl bg-green-600 flex items-center justify-center text-white font-extrabold text-base shadow-sm">
          HM
        </div>
        <div>
          <div class="flex items-center gap-1.5">
            <span class="font-extrabold text-slate-900 tracking-tight text-base">Home Mart</span>
            <span class="bg-green-100 text-green-700 font-bold text-[10px] px-1.5 py-0.5 rounded-full uppercase tracking-wider">FRESH</span>
          </div>
          <p class="text-[11px] text-slate-500 flex items-center gap-1">
            <i class="fa-solid fa-location-dot text-green-600 text-xs"></i> <span id="headerLocation">Indiranagar</span> • <span class="text-green-700 font-semibold" id="headerEta">15–25 mins</span>
          </p>
        </div>
      </div>
      <div class="flex items-center gap-2">
        <!-- Customer Notifications Bell -->
        <button onclick="openCustomerNotificationsModal()" class="relative w-9 h-9 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-700 flex items-center justify-center text-sm border border-slate-200/80 transition" title="Store Announcements">
          <i class="fa-regular fa-bell"></i>
          <span id="unreadNotifBadge" class="absolute -top-1 -right-1 bg-red-500 text-white font-black text-[9px] w-4 h-4 rounded-full flex items-center justify-center shadow-xs">3</span>
        </button>

        <!-- Store Owner Admin Login -->
        <button onclick="openPinModal()" class="px-2.5 py-1.5 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold text-xs flex items-center gap-1.5 border border-slate-200/80 transition" title="Store Ops & Fleet Admin">
          <i class="fa-solid fa-shield-halved text-green-600"></i>
          <span>Admin</span>
        </button>

        <!-- WhatsApp Support Helpline -->
        <a href="https://wa.me/917006934064" id="headerWaLink" target="_blank" class="w-9 h-9 rounded-full bg-emerald-50 text-emerald-600 flex items-center justify-center text-base shadow-xs border border-emerald-100" title="Store WhatsApp Helpline">
          <i class="fa-brands fa-whatsapp"></i>
        </a>
      </div>
    </div>

    <!-- Search Box (Storefront Tab Only) -->
    <div id="searchBarContainer" class="mt-2.5 max-w-md mx-auto relative">
      <i class="fa-solid fa-magnifying-glass absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400 text-xs"></i>
      <input type="text" id="searchInput" oninput="renderStorefront()" placeholder="Search apples, tomatoes, rice, diaper, dal..." class="w-full pl-9 pr-4 py-2 bg-slate-100 border border-slate-200/80 rounded-xl text-xs placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-green-500 focus:bg-white transition">
    </div>
  </header>

  <!-- ================= VIEW 1: STOREFRONT ================= -->
  <section id="view-store" class="block max-w-md mx-auto">
    <!-- Promotional Hero Banner -->
    <div class="p-4">
      <div class="bg-gradient-to-r from-green-700 via-emerald-600 to-green-600 rounded-2xl p-4 text-white shadow-md relative overflow-hidden">
        <span class="bg-white/20 text-white font-semibold text-[10px] uppercase px-2 py-0.5 rounded-full tracking-wider">Direct Farm Harvest</span>
        <h2 class="text-lg font-black mt-1 leading-tight">Super Fresh Produce & Daily Staples</h2>
        <p class="text-xs text-green-100 mt-0.5">Free 20-min delivery on orders above ₹199</p>
        <div class="mt-2.5 inline-flex items-center gap-1.5 bg-white text-green-800 text-xs font-bold px-3 py-1.5 rounded-xl shadow-xs">
          ⚡ 0% Fee UPI & WhatsApp Ready <i class="fa-solid fa-bolt text-[10px]"></i>
        </div>
      </div>
    </div>

    <!-- Category Filter Pills -->
    <div class="px-4 flex gap-2 overflow-x-auto no-scrollbar pb-2 text-xs font-semibold">
      <button onclick="setCategory('all')" class="cat-pill bg-green-600 text-white px-3.5 py-1.5 rounded-full shrink-0 shadow-xs">All Items</button>
      <button onclick="setCategory('fruits')" class="cat-pill bg-white text-slate-600 border border-slate-200 px-3.5 py-1.5 rounded-full shrink-0">🍎 Fruits & Veggies</button>
      <button onclick="setCategory('staples')" class="cat-pill bg-white text-slate-600 border border-slate-200 px-3.5 py-1.5 rounded-full shrink-0">🌾 Rice, Dal & Staples</button>
      <button onclick="setCategory('baby')" class="cat-pill bg-white text-slate-600 border border-slate-200 px-3.5 py-1.5 rounded-full shrink-0">👶 Baby Care</button>
      <button onclick="setCategory('toiletries')" class="cat-pill bg-white text-slate-600 border border-slate-200 px-3.5 py-1.5 rounded-full shrink-0">🧼 Toiletries</button>
    </div>

    <!-- Freshness Guarantee & Reversal Policy Banner -->
    <div class="px-4 mt-1">
      <div class="p-3 rounded-2xl bg-gradient-to-r from-emerald-50 to-teal-50 border border-emerald-200/80 shadow-xs flex items-center justify-between">
        <div class="flex items-center gap-2.5">
          <div class="w-8 h-8 rounded-full bg-emerald-600 text-white flex items-center justify-center shrink-0 text-sm">
            <i class="fa-solid fa-shield-heart"></i>
          </div>
          <div>
            <p class="text-xs font-bold text-emerald-950">100% Freshness Guarantee</p>
            <p class="text-[11px] text-emerald-800 leading-tight">Instant UPI reversal within 2 hours for damaged greens</p>
          </div>
        </div>
        <button onclick="switchView('receipt')" class="text-xs font-bold text-emerald-700 hover:text-emerald-900 shrink-0 flex items-center gap-1">
          Returns <i class="fa-solid fa-chevron-right text-[10px]"></i>
        </button>
      </div>
    </div>

    <!-- Products Grid -->
    <main class="px-4 mt-3">
      <div class="flex items-center justify-between mb-3">
        <h3 class="font-extrabold text-slate-900 text-sm">Fresh Daily Catalog</h3>
        <span class="text-[11px] font-semibold text-green-700"><i class="fa-solid fa-badge-check"></i> Best Market Rates</span>
      </div>
      <div id="productGrid" class="grid grid-cols-2 gap-3 pb-8"></div>
    </main>
  </section>

  <!-- ================= VIEW 2: BASKET ================= -->
  <section id="view-basket" class="hidden p-4 max-w-md mx-auto">
    <div class="flex items-center justify-between mb-3">
      <h2 class="text-base font-extrabold text-slate-900 flex items-center gap-2">
        <i class="fa-solid fa-basket-shopping text-green-600"></i> Your Basket
      </h2>
      <button onclick="clearBasket()" class="text-xs text-red-500 font-semibold flex items-center gap-1">
        <i class="fa-solid fa-trash-can text-[10px]"></i> Clear
      </button>
    </div>

    <!-- Active Delivery Partner Live Preview Card -->
    <div class="p-3.5 rounded-2xl bg-emerald-50/70 border border-emerald-200/70 flex items-center justify-between mb-3">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-xl bg-green-600 text-white flex items-center justify-center font-bold text-base shadow-xs">
          <i class="fa-solid fa-person-biking"></i>
        </div>
        <div>
          <div class="flex items-center gap-1.5">
            <span class="text-xs font-bold text-slate-900" id="basketRiderName">Ramesh K.</span>
            <span class="text-[9px] px-1.5 py-0.2 rounded-full bg-emerald-200 text-emerald-900 font-bold uppercase">Active Partner</span>
          </div>
          <p class="text-[11px] text-slate-600" id="basketHubDesc">Electric EV Hub #4 • Delivery in 15–25 mins</p>
        </div>
      </div>
      <a href="tel:+917006934064" id="basketRiderCall" class="w-8 h-8 rounded-full bg-white text-green-700 border border-green-200 flex items-center justify-center text-xs shadow-xs">
        <i class="fa-solid fa-phone"></i>
      </a>
    </div>

    <div id="basketItemsList" class="space-y-3"></div>

    <div id="emptyBasketNotice" class="hidden text-center py-16">
      <div class="w-16 h-16 bg-green-50 rounded-full flex items-center justify-center text-green-600 text-2xl mx-auto mb-3">
        <i class="fa-solid fa-basket-shopping"></i>
      </div>
      <h3 class="font-bold text-slate-800 text-sm">Your basket is empty</h3>
      <p class="text-xs text-slate-400 mt-1 mb-4">Add crisp fruits, fresh veggies & daily staples</p>
      <button onclick="switchView('store')" class="bg-green-600 text-white font-bold text-xs px-5 py-2.5 rounded-xl shadow-xs">
        Browse Fresh Produce
      </button>
    </div>

    <!-- Bill Breakdown Card -->
    <div id="billCard" class="mt-5 bg-white border border-slate-100 rounded-2xl p-4 shadow-xs">
      <h3 class="font-extrabold text-slate-900 text-xs uppercase tracking-wider mb-3">Bill Breakdown</h3>
      <div class="space-y-2 text-xs">
        <div class="flex justify-between text-slate-600">
          <span>Items Subtotal</span>
          <span id="subtotalDisplay" class="font-semibold text-slate-800">₹0</span>
        </div>
        <div class="flex justify-between text-emerald-600">
          <span>Flash Discount (₹50 off > ₹300)</span>
          <span id="discountDisplay" class="font-semibold">-₹0</span>
        </div>
        <div class="flex justify-between text-slate-600">
          <span>Delivery Partner Fee</span>
          <span class="text-green-600 font-bold uppercase text-[10px] bg-green-50 px-1.5 py-0.5 rounded">FREE (Express)</span>
        </div>
        <div class="flex justify-between text-slate-600">
          <span>Eco Packaging & Handling</span>
          <span class="font-semibold text-slate-800">₹6</span>
        </div>
        <div class="border-t border-slate-100 pt-2 flex justify-between text-sm font-extrabold text-slate-900">
          <span>Total Payable</span>
          <span id="totalDisplay" class="text-green-700 font-black">₹0</span>
        </div>
      </div>
    </div>

    <div id="proceedCheckoutBtn" class="mt-4">
      <button onclick="switchView('checkout')" class="w-full bg-green-600 hover:bg-green-700 text-white font-extrabold py-3.5 px-4 rounded-2xl shadow-lg flex items-center justify-between text-sm transition">
        <span id="basketPayAmount">Pay ₹0</span>
        <span class="flex items-center gap-1.5">Proceed to Checkout <i class="fa-solid fa-arrow-right text-xs"></i></span>
      </button>
    </div>
  </section>

  <!-- ================= VIEW 3: CHECKOUT & PAYMENT ================= -->
  <section id="view-checkout" class="hidden p-4 space-y-4 max-w-md mx-auto">
    <div class="flex items-center justify-between">
      <h2 class="text-base font-extrabold text-slate-900 flex items-center gap-2">
        <i class="fa-solid fa-shield-check text-green-600"></i> Express Checkout
      </h2>
      <span class="text-[10px] font-bold text-emerald-700 bg-emerald-50 px-2 py-0.5 rounded-full border border-emerald-100">
        100% Safe
      </span>
    </div>

    <!-- Customer Recognition & Loyalty Badge (Dynamic Lookup) -->
    <div id="checkoutLoyaltyBanner" class="p-3.5 rounded-2xl bg-gradient-to-r from-amber-50 to-orange-50 border border-amber-200/80 flex items-center justify-between">
      <div class="flex items-center gap-2.5">
        <div class="w-9 h-9 rounded-xl bg-amber-500 text-white flex items-center justify-center font-bold text-sm shadow-xs shrink-0">
          <i class="fa-solid fa-gift"></i>
        </div>
        <div>
          <div class="flex items-center gap-1.5">
            <span class="text-xs font-bold text-slate-900" id="checkoutCustTierBadge">🌱 Home Mart Shopper</span>
            <span class="text-[9px] bg-amber-200 text-amber-900 font-extrabold px-1.5 py-0.2 rounded-full">CRM Synced</span>
          </div>
          <p class="text-[11px] text-amber-900 font-medium mt-0.5" id="checkoutCustPerkDesc">Order today to earn loyalty harvest points & gifts!</p>
        </div>
      </div>
      <i class="fa-solid fa-certificate text-amber-600 text-lg"></i>
    </div>

    <!-- Customer Address Details Card -->
    <div class="bg-white border border-slate-100 rounded-2xl p-4 shadow-xs space-y-2">
      <div class="flex items-center justify-between">
        <span class="text-xs font-bold text-slate-900 flex items-center gap-1.5">
          <i class="fa-solid fa-house-chimney text-green-600"></i> Delivery Address & Customer Details
        </span>
        <span class="text-[10px] text-slate-400">Auto-saved to CRM</span>
      </div>
      <div>
        <label class="text-[10px] font-bold text-slate-500 block mb-0.5">Your Full Name</label>
        <input type="text" id="custName" oninput="lookupCustomerByPhone()" value="Aditi Sharma" placeholder="e.g. Aditi Sharma" class="w-full text-xs font-bold text-slate-800 border-b border-slate-200 pb-1.5 focus:outline-none focus:border-green-500">
      </div>
      <div>
        <label class="text-[10px] font-bold text-slate-500 block mb-0.5">Mobile Phone (10 digits)</label>
        <input type="tel" id="custPhone" oninput="lookupCustomerByPhone()" value="9876543210" placeholder="e.g. 9876543210" class="w-full text-xs text-slate-700 border border-slate-200 rounded-xl p-2.5 focus:outline-none focus:ring-1 focus:ring-green-500">
      </div>
      <div>
        <label class="text-[10px] font-bold text-slate-500 block mb-0.5">Delivery Address & Landmark</label>
        <textarea id="custAddress" rows="2" placeholder="Flat No, Apartment, Street, Landmark, Indiranagar" class="w-full text-xs text-slate-600 border border-slate-200 rounded-xl p-2.5 focus:outline-none focus:ring-1 focus:ring-green-500">Flat 402, Green Glen Layout, Indiranagar, Bengaluru</textarea>
      </div>
    </div>

    <!-- UPI QR Code & Direct Pay Card -->
    <div class="bg-gradient-to-br from-white to-green-50/50 border-2 border-green-500/30 rounded-2xl p-4 shadow-xs">
      <div class="flex items-center justify-between mb-3">
        <div class="flex items-center gap-2">
          <div class="w-7 h-7 rounded-lg bg-green-600 text-white flex items-center justify-center text-xs">
            <i class="fa-solid fa-qrcode"></i>
          </div>
          <div>
            <h3 class="font-extrabold text-xs text-slate-900">Home Mart Official UPI</h3>
            <p class="text-[10px] text-green-700 font-semibold">0% Surcharge • Scan & Pay</p>
          </div>
        </div>
        <span class="bg-green-600 text-white font-bold text-[9px] uppercase px-2 py-0.5 rounded-full">Official</span>
      </div>

      <div class="bg-white border border-green-200/80 rounded-xl p-3 flex items-center justify-between">
        <div>
          <div class="text-[10px] text-slate-400 font-medium">Store UPI ID</div>
          <div class="text-xs font-extrabold text-slate-900 font-mono tracking-tight" id="checkoutUpiIdDisplay">9082207857@ybl</div>
          <div class="text-[10px] text-slate-500">Merchant: Home Mart Fresh Retail</div>
        </div>
        <button onclick="copyUpi()" class="bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-bold px-3 py-1.5 rounded-lg flex items-center gap-1 transition">
          <i class="fa-regular fa-copy text-[10px]"></i> <span id="copyUpiLabel">Copy</span>
        </button>
      </div>
      <div class="mt-3 flex items-center gap-3 text-[11px] text-slate-500">
        <span class="flex items-center gap-1"><i class="fa-brands fa-google-pay text-base text-slate-700"></i> GPay</span>
        <span class="flex items-center gap-1"><i class="fa-solid fa-bolt text-xs text-purple-600"></i> PhonePe</span>
        <span class="flex items-center gap-1"><i class="fa-solid fa-wallet text-xs text-blue-600"></i> Paytm</span>
      </div>
    </div>

    <!-- Payment Choice Radios -->
    <div class="bg-white border border-slate-100 rounded-2xl p-4 shadow-xs space-y-2.5">
      <h3 class="font-bold text-xs text-slate-900 mb-2">Select Payment Method</h3>
      <label class="flex items-center justify-between p-2.5 border border-green-500 bg-green-50/40 rounded-xl cursor-pointer">
        <div class="flex items-center gap-2.5">
          <input type="radio" name="payMethod" value="UPI QR (9082207857@ybl)" checked class="text-green-600 focus:ring-green-500">
          <div>
            <div class="text-xs font-bold text-slate-800">Scan UPI QR / 9082207857@ybl</div>
            <div class="text-[10px] text-slate-500">Fast UPI app transfer or WhatsApp screenshot</div>
          </div>
        </div>
        <i class="fa-solid fa-circle-check text-green-600 text-sm"></i>
      </label>
      <label class="flex items-center justify-between p-2.5 border border-slate-200 rounded-xl cursor-pointer">
        <div class="flex items-center gap-2.5">
          <input type="radio" name="payMethod" value="Cash on Delivery (COD)" class="text-green-600 focus:ring-green-500">
          <div>
            <div class="text-xs font-bold text-slate-800">Cash on Delivery (COD)</div>
            <div class="text-[10px] text-slate-500">Pay cash or rider QR upon receipt</div>
          </div>
        </div>
        <i class="fa-solid fa-money-bill-wave text-slate-400 text-sm"></i>
      </label>
    </div>

    <!-- 1-Tap Place WhatsApp Order CTA -->
    <button onclick="placeWhatsAppOrder()" class="w-full bg-green-700 hover:bg-green-800 text-white font-extrabold py-3.5 px-4 rounded-2xl shadow-xl flex items-center justify-between text-sm transition">
      <span id="checkoutTotalBtn">Pay ₹0</span>
      <span class="flex items-center gap-2">Place Order on WhatsApp <i class="fa-brands fa-whatsapp text-base"></i></span>
    </button>
  </section>

  <!-- ================= VIEW 4: RECEIPT, TRACKING & UPI RETURN REVERSAL ================= -->
  <section id="view-receipt" class="hidden p-4 space-y-4 max-w-md mx-auto">
    <div class="text-center pt-2">
      <div class="w-16 h-16 bg-green-100 text-green-600 rounded-full flex items-center justify-center text-2xl mx-auto shadow-inner">
        <i class="fa-solid fa-circle-check"></i>
      </div>
      <span class="inline-block bg-green-100 text-green-800 font-bold text-[10px] px-2.5 py-0.5 rounded-full mt-2 uppercase tracking-wide">
        ● Live Order Active
      </span>
      <h2 class="text-xl font-extrabold text-slate-900 mt-1">Order Confirmed!</h2>
      <p id="receiptOrderId" class="text-xs text-slate-500 font-mono mt-0.5">Order #HM-84920</p>
    </div>

    <!-- Valued Customer Perk Badge on Receipt -->
    <div class="p-3 rounded-2xl bg-amber-50 border border-amber-200 flex items-center justify-between">
      <div class="flex items-center gap-2.5">
        <span class="text-xl">⭐</span>
        <div>
          <div class="flex items-center gap-1.5">
            <h4 class="text-xs font-bold text-slate-900" id="receiptCustName">Valued Shopper</h4>
            <span class="text-[9px] font-bold px-1.5 py-0.2 rounded-full bg-amber-200 text-amber-900" id="receiptCustTier">Gold Tier</span>
          </div>
          <p class="text-[11px] text-amber-800" id="receiptCustPerk">Special perk: Free 500g Fresh Mangoes credited!</p>
        </div>
      </div>
      <button onclick="alert('🎁 Your loyalty points & perks are credited to your WhatsApp profile after delivery!')" class="text-xs font-bold text-green-700">Details</button>
    </div>

    <!-- Live ETA Tracker -->
    <div class="bg-white border border-slate-100 rounded-2xl p-4 shadow-xs">
      <div class="flex items-center justify-between mb-3">
        <div>
          <div class="text-[11px] text-slate-400 font-medium">Estimated Arrival</div>
          <div class="text-base font-extrabold text-slate-900 flex items-center gap-1.5">
            <span class="text-green-600" id="receiptEtaText">Arriving in 15–25 mins</span>
          </div>
        </div>
        <span class="bg-green-100 text-green-800 text-[10px] font-bold px-2 py-1 rounded-lg">Express EV</span>
      </div>
      <div class="grid grid-cols-4 gap-1 text-center pt-2 border-t border-slate-100">
        <div>
          <div class="w-6 h-6 rounded-full bg-green-600 text-white flex items-center justify-center text-[10px] mx-auto mb-1">✓</div>
          <div class="text-[9px] font-bold text-slate-800">Placed</div>
        </div>
        <div>
          <div class="w-6 h-6 rounded-full bg-green-600 text-white flex items-center justify-center text-[10px] mx-auto mb-1 animate-pulse">📦</div>
          <div class="text-[9px] font-bold text-green-700">Packing</div>
        </div>
        <div>
          <div class="w-6 h-6 rounded-full bg-slate-200 text-slate-400 flex items-center justify-center text-[10px] mx-auto mb-1">🛵</div>
          <div class="text-[9px] text-slate-400">On Way</div>
        </div>
        <div>
          <div class="w-6 h-6 rounded-full bg-slate-200 text-slate-400 flex items-center justify-center text-[10px] mx-auto mb-1">🏠</div>
          <div class="text-[9px] text-slate-400">Delivered</div>
        </div>
      </div>
    </div>

    <!-- Active Delivery Partner Card (Dynamic from Fleet) -->
    <div class="bg-white border border-slate-100 rounded-2xl p-4 shadow-xs space-y-3">
      <div class="flex items-center justify-between">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-full bg-green-50 text-green-700 flex items-center justify-center text-lg">🛵</div>
