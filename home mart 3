    function toggleRiderForm(show = null) {
      const panel = document.getElementById('riderFormPanel');
      const btn = document.getElementById('btnToggleRiderForm');
      const title = document.getElementById('riderFormTitle');
      const editId = document.getElementById('editRiderId');
      if (!panel) return;

      const willShow = show !== null ? show : panel.classList.contains('hidden');
      if (willShow) {
        panel.classList.remove('hidden');
        if (btn) btn.innerText = "✕ Close";
      } else {
        panel.classList.add('hidden');
        if (btn) btn.innerText = "+ Add Rider";
        if (editId) editId.value = "";
        if (title) title.innerText = "Register New Delivery Rider";
        resetRiderInputs();
      }
    }

    function resetRiderInputs() {
      document.getElementById('riderNameInput').value = '';
      document.getElementById('riderPhoneInput').value = '';
      document.getElementById('riderVehicleInput').value = 'Electric EV Hub #4';
      document.getElementById('riderRatingInput').value = '4.9★';
