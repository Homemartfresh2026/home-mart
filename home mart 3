            ` : qty === 0 ? `
              <button onclick="addToCart(${p.id})" class="w-full py-1.5 bg-green-50 hover:bg-green-100 border border-green-200 text-green-700 rounded-xl text-xs font-bold transition flex items-center justify-center gap-1">
