        const card = document.createElement('div');
        card.className = `bg-white border ${isOut ? 'border-slate-200 opacity-60' : 'border-slate-100'} rounded-2xl p-3 shadow-xs flex flex-col justify-between`;
        card.innerHTML = `
          <div>
            <div class="flex justify-between items-start mb-2">
              <span class="${isOut ? 'bg-red-50 text-red-600' : 'bg-green-50 text-green-700'} text-[9px] font-bold px-1.5 py-0.5 rounded-md">
