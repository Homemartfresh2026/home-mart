              </button>
            ` : `
              <div class="flex items-center justify-between bg-green-600 text-white rounded-xl px-2 py-1">
                <button onclick="changeQty(${p.id}, -1)" class="w-6 h-6 flex items-center justify-center font-bold text-sm">－</button>
