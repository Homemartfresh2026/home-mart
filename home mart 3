    function addToCart(id) {
      const prod = products.find(p => p.id === id);
      if (prod && prod.inStock === false) {
        alert("This item is currently sold out.");
        return;
      }
      cart[id] = (cart[id] || 0) + 1;
      saveCart();
      renderStorefront();
      renderBasket();
    }

    function changeQty(id, delta) {
      cart[id] = (cart[id] || 0) + delta;
      if (cart[id] <= 0) delete cart[id];
      saveCart();
      renderStorefront();
      renderBasket();
    }

    function clearBasket() {
      cart = {};
      saveCart();
      renderStorefront();
      renderBasket();
    }

    function setCategory(cat) {
      activeCat = cat;
      document.querySelectorAll('.cat-pill').forEach(btn => {
        btn.className = "cat-pill bg-white text-slate-600 border border-slate-200 px-3.5 py-1.5 rounded-full shrink-0";
      });
      event.target.className = "cat-pill bg-green-600 text-white px-3.5 py-1.5 rounded-full shrink-0 shadow-xs";
      renderStorefront();
    }

    function calculateTotals() {
      let subtotal = 0;
      let count = 0;
      for (const [id, qty] of Object.entries(cart)) {
        const item = products.find(p => p.id == id);
        if (item && qty > 0) {
          count += qty;
          subtotal += (item.price * qty);
        }
      }
      const discount = subtotal > 300 ? 50 : 0;
      const total = subtotal > 0 ? (subtotal - discount + 6) : 0;
      return { count, subtotal, discount, total };
    }

    function updateCartCounts() {
      const { count, total } = calculateTotals();
      const stickyBar = document.getElementById('stickyCartBar');
      if (count > 0 && currentView === 'store') {
        document.getElementById('cartCountBadge').innerText = count;
        document.getElementById('cartTotalDisplay').innerText = `₹${total}`;
        stickyBar.classList.remove('translate-y-32');
      } else {
        stickyBar.classList.add('translate-y-32');
      }
    }

    function renderBasket() {
      const { count, subtotal, discount, total } = calculateTotals();
      const container = document.getElementById('basketItemsList');
      container.innerHTML = '';

      for (const [id, qty] of Object.entries(cart)) {
        const item = products.find(p => p.id == id);
        if (item && qty > 0) {
          const lineTotal = item.price * qty;
          const el = document.createElement('div');
          el.className = "bg-white border border-slate-100 rounded-2xl p-3 shadow-xs flex items-center justify-between";
          el.innerHTML = `
            <div class="flex items-center gap-3">
              <div class="text-2xl">${item.emoji}</div>
              <div>
                <h4 class="font-bold text-xs text-slate-800">${item.name}</h4>
                <div class="text-[10px] text-slate-400">₹${item.price} • ${item.unit}</div>
              </div>
            </div>
            <div class="flex items-center gap-3">
              <div class="flex items-center bg-slate-100 rounded-xl px-2 py-1">
                <button onclick="changeQty(${item.id}, -1)" class="w-5 h-5 flex items-center justify-center font-bold text-xs text-slate-600">－</button>
                <span class="text-xs font-bold text-slate-800 px-2">${qty}</span>
                <button onclick="changeQty(${item.id}, 1)" class="w-5 h-5 flex items-center justify-center font-bold text-xs text-slate-600">＋</button>
              </div>
              <div class="text-xs font-extrabold text-slate-900 w-12 text-right">₹${lineTotal}</div>
            </div>
          `;
          container.appendChild(el);
        }
      }

      if (count === 0) {
        document.getElementById('emptyBasketNotice').classList.remove('hidden');
        document.getElementById('billCard').classList.add('hidden');
        document.getElementById('proceedCheckoutBtn').classList.add('hidden');
      } else {
        document.getElementById('emptyBasketNotice').classList.add('hidden');
        document.getElementById('billCard').classList.remove('hidden');
        document.getElementById('proceedCheckoutBtn').classList.remove('hidden');

        document.getElementById('subtotalDisplay').innerText = `₹${subtotal}`;
        document.getElementById('discountDisplay').innerText = `-₹${discount}`;
        document.getElementById('totalDisplay').innerText = `₹${total}`;
        document.getElementById('basketPayAmount').innerText = `Pay ₹${total}`;
        document.getElementById('checkoutTotalBtn').innerText = `Total: ₹${total}`;
      }
    }

    function switchView(view) {
      currentView = view;
      ['store', 'basket', 'checkout', 'receipt', 'admin'].forEach(v => {
        const el = document.getElementById(`view-${v}`);
        const tab = document.getElementById(`tab-${v}`);
        if (el) {
          if (v === view) {
            el.classList.remove('hidden');
            if (tab) tab.className = "flex flex-col items-center text-green-600 font-bold text-[10px]";
          } else {
            el.classList.add('hidden');
            if (tab) tab.className = "flex flex-col items-center text-slate-400 text-[10px]";
          }
        }
      });

      const searchBox = document.getElementById('searchBarContainer');
      if (view === 'store') searchBox.classList.remove('hidden');
      else searchBox.classList.add('hidden');

      if (view === 'basket') renderBasket();
      if (view === 'checkout') {
        const { total, count } = calculateTotals();
        if (count === 0) {
          switchView('basket');
          return;
        }
        document.getElementById('checkoutTotalBtn').innerText = `Total: ₹${total}`;
        lookupCustomerByPhone();
      }
      if (view === 'admin') {
        renderFleetList();
        renderCRMList();
        renderAdminProducts();
        renderAdminNotifications();
      }
      updateCartCounts();
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }

