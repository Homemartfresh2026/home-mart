    function calculateTotals() {
      let subtotal = 0;
      let count = 0;
      for (const [id, qty] of Object.entries(cart)) {
        const item = products.find(p => p.id == id);
        if (item && qty > 0) {
          count += qty;
          subtotal += (item.price * qty);
        }
      }
      const discount = subtotal > 300 ? 50 : 0;
      const total = subtotal > 0 ? (subtotal - discount + 6) : 0;
      return { count, subtotal, discount, total };
    }

    function updateCartCounts() {
      const { count, total } = calculateTotals();
      const stickyBar = document.getElementById('stickyCartBar');
      if (!stickyBar) return;
      if (count > 0 && currentView === 'store') {
        document.getElementById('cartCountBadge').innerText = count;
        document.getElementById('cartTotalDisplay').innerText = `₹${total}`;
        stickyBar.classList.remove('translate-y-32');
      } else {
        stickyBar.classList.add('translate-y-32');
      }
    }

