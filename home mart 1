<!DOCTYPE html>

<html lang="en"><head>
<meta charset="utf-8"/>
<meta content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" name="viewport"/>
<title>Home Mart FRESH — Online Grocery</title>
<script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet"/>
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&amp;family=Inter:wght@400;500;600;700;800&amp;display=swap" rel="stylesheet"/>
<style>
    body { font-family: 'Plus Jakarta Sans', sans-serif; background-color: #faf8ff; -webkit-tap-highlight-color: transparent; }
    .no-scrollbar::-webkit-scrollbar { display: none; }
    .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
  </style>
</head>
<body class="text-slate-800 pb-24 select-none min-h-screen">
<!-- ================= CUSTOMER TOP ALERT BANNER (Managed by Admin) ================= -->
<div class="hidden transition-all duration-300 relative text-xs font-semibold px-4 py-2 flex items-center justify-between shadow-xs z-30" id="storeTopBanner">
<div class="flex items-center gap-2 overflow-hidden mr-2">
<span class="shrink-0 text-sm" id="bannerEmoji">📢</span>
<p class="truncate text-[11px] font-bold" id="bannerTextContent"></p>
</div>
<button class="shrink-0 text-slate-500 hover:text-slate-800 p-1 transition" onclick="dismissTopBanner()" title="Dismiss">
<i class="fa-solid fa-xmark text-xs"></i>
</button>
</div>
<!-- ================= TOP APP BAR ================= -->
<header class="sticky top-0 z-40 bg-white/95 backdrop-blur border-b border-slate-100 px-4 py-3 shadow-xs">
<div class="flex items-center justify-between">
<div class="flex items-center gap-2.5">
<div class="w-9 h-9 rounded-xl bg-green-600 flex items-center justify-center text-white font-extrabold text-base shadow-sm">
          HM
        </div>
<div>
<div class="flex items-center gap-1.5">
<span class="font-extrabold text-slate-900 tracking-tight text-base">Home Mart</span>
<span class="bg-green-100 text-green-700 font-bold text-[10px] px-1.5 py-0.5 rounded-full uppercase tracking-wider">FRESH</span>
</div>
<p class="text-[11px] text-slate-500 flex items-center gap-1">
<i class="fa-solid fa-location-dot text-green-600 text-xs"></i> Express Delivery • <span class="text-green-700 font-semibold">15–25 mins</span>
</p>
</div>
</div>
<div class="flex items-center gap-2">
<!-- Customer Notification Bell Icon -->
<button class="relative w-9 h-9 rounded-full bg-slate-100 hover:bg-slate-200 text-slate-700 flex items-center justify-center transition border border-slate-200/70" onclick="toggleCustomerNoticeModal()" title="Store Announcements">
<i class="fa-regular fa-bell text-sm"></i>
<span class="hidden absolute -top-0.5 -right-0.5 w-4 h-4 rounded-full bg-rose-500 text-white text-[9px] font-bold flex items-center justify-center border-2 border-white" id="unreadNotifBadge">0</span>
</button>
<!-- Store Admin Button -->
<button class="h-9 px-2.5 rounded-full bg-slate-100 hover:bg-slate-200 text-slate-700 flex items-center gap-1.5 text-xs font-bold transition shadow-xs border border-slate-200/70" onclick="openAdminAuthModal()" title="Store Owner Admin Panel">
<i class="fa-solid fa-shield-halved text-green-700 text-xs"></i>
<span class="text-[11px] text-slate-800">Admin</span>
</button>
<a class="w-9 h-9 rounded-full bg-emerald-50 text-emerald-600 flex items-center justify-center text-base shadow-xs border border-emerald-100 hover:bg-emerald-100 transition" href="https://wa.me/917006934064" id="headerWaLink" target="_blank" title="Store WhatsApp">
<i class="fa-brands fa-whatsapp"></i>
</a>
</div>
</div>
<!-- Search Box (Storefront Tab Only) -->
<div class="mt-2.5 relative" id="searchBarContainer">
<i class="fa-solid fa-magnifying-glass absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400 text-xs"></i>
<input class="w-full pl-9 pr-4 py-2 bg-slate-100 border border-slate-200/80 rounded-xl text-xs placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-green-500 focus:bg-white transition" id="searchInput" oninput="renderStorefront()" placeholder="Search apples, tomatoes, rice, diaper, dal..." type="text"/>
</div>
</header>
<!-- ================= CUSTOMER NOTIFICATIONS DRAWER / MODAL ================= -->
<div class="fixed inset-0 z-50 bg-slate-900/60 backdrop-blur-sm hidden flex items-end sm:items-center justify-center p-0 sm:p-4 transition-all" id="customerNoticeModal">
<div class="bg-white w-full max-w-md rounded-t-3xl sm:rounded-3xl p-5 shadow-2xl border border-slate-100 max-h-[85vh] flex flex-col animate-in fade-in zoom-in duration-150">
<div class="flex items-center justify-between pb-3 border-b border-slate-100">
<div class="flex items-center gap-2">
<div class="w-8 h-8 rounded-xl bg-green-50 text-green-700 flex items-center justify-center text-sm font-bold">
<i class="fa-solid fa-bullhorn"></i>
</div>
<div>
<h3 class="text-sm font-extrabold text-slate-900">Store Announcements &amp; Alerts</h3>
<p class="text-[10px] text-slate-400">Live updates directly from Home Mart Fresh</p>
</div>
</div>
<button class="w-7 h-7 rounded-full bg-slate-100 text-slate-400 hover:text-slate-700 flex items-center justify-center transition" onclick="toggleCustomerNoticeModal()">
<i class="fa-solid fa-xmark text-xs"></i>
</button>
</div>
<!-- Notice List -->
<div class="overflow-y-auto no-scrollbar space-y-2.5 py-4 flex-1" id="customerNoticeList">
<!-- Injected via JavaScript -->
</div>
<div class="pt-2 border-t border-slate-100 flex items-center justify-between text-[11px] text-slate-400">
<span class="flex items-center gap-1"><i class="fa-solid fa-circle-check text-green-600"></i> Store-verified Broadcasts</span>
<button class="font-bold text-green-700 hover:underline" onclick="toggleCustomerNoticeModal()">Got it</button>
</div>
</div>
</div>
<!-- ================= PIN AUTH MODAL ================= -->
<div class="fixed inset-0 z-50 bg-slate-900/60 backdrop-blur-sm hidden flex items-center justify-center p-4 transition-all" id="adminAuthModal">
<div class="bg-white w-full max-w-sm rounded-3xl p-6 shadow-2xl border border-slate-100 text-center relative animate-in fade-in zoom-in duration-150">
<button class="absolute top-4 right-4 w-8 h-8 rounded-full bg-slate-100 text-slate-400 hover:text-slate-700 flex items-center justify-center transition" onclick="closeAdminAuthModal()">
<i class="fa-solid fa-xmark text-sm"></i>
</button>
<div class="w-14 h-14 bg-green-50 text-green-700 rounded-2xl flex items-center justify-center text-2xl mx-auto mb-3 shadow-inner border border-green-100">
<i class="fa-solid fa-shield-halved"></i>
</div>
<h3 class="text-base font-extrabold text-slate-900">Store Owner Access</h3>
<p class="text-xs text-slate-500 mt-1 mb-4">Enter 4-digit PIN to manage live rates, catalog &amp; stock (Default: <span class="font-mono font-bold text-green-700">7006</span>)</p>
<!-- PIN Dots Indicator -->
<div class="flex justify-center gap-3 mb-5" id="pinDotsWrapper">
<span class="pin-dot w-3.5 h-3.5 rounded-full border-2 border-slate-300 bg-slate-100 transition-all"></span>
<span class="pin-dot w-3.5 h-3.5 rounded-full border-2 border-slate-300 bg-slate-100 transition-all"></span>
<span class="pin-dot w-3.5 h-3.5 rounded-full border-2 border-slate-300 bg-slate-100 transition-all"></span>
<span class="pin-dot w-3.5 h-3.5 rounded-full border-2 border-slate-300 bg-slate-100 transition-all"></span>
</div>
<p class="text-[11px] font-semibold text-rose-500 hidden mb-3" id="pinErrorMessage">
<i class="fa-solid fa-circle-exclamation"></i> Incorrect PIN. Please try again.
</p>
<!-- Keypad -->
<div class="grid grid-cols-3 gap-2 max-w-[220px] mx-auto">
<button class="py-3 bg-slate-50 hover:bg-slate-100 active:bg-slate-200 text-slate-800 text-lg font-bold rounded-xl transition border border-slate-100" onclick="pressPinKey('1')">1</button>
<button class="py-3 bg-slate-50 hover:bg-slate-100 active:bg-slate-200 text-slate-800 text-lg font-bold rounded-xl transition border border-slate-100" onclick="pressPinKey('2')">2</button>
<button class="py-3 bg-slate-50 hover:bg-slate-100 active:bg-slate-200 text-slate-800 text-lg font-bold rounded-xl transition border border-slate-100" onclick="pressPinKey('3')">3</button>
<button class="py-3 bg-slate-50 hover:bg-slate-100 active:bg-slate-200 text-slate-800 text-lg font-bold rounded-xl transition border border-slate-100" onclick="pressPinKey('4')">4</button>
<button class="py-3 bg-slate-50 hover:bg-slate-100 active:bg-slate-200 text-slate-800 text-lg font-bold rounded-xl transition border border-slate-100" onclick="pressPinKey('5')">5</button>
<button class="py-3 bg-slate-50 hover:bg-slate-100 active:bg-slate-200 text-slate-800 text-lg font-bold rounded-xl transition border border-slate-100" onclick="pressPinKey('6')">6</button>
<button class="py-3 bg-slate-50 hover:bg-slate-100 active:bg-slate-200 text-slate-800 text-lg font-bold rounded-xl transition border border-slate-100" onclick="pressPinKey('7')">7</button>
<button class="py-3 bg-slate-50 hover:bg-slate-100 active:bg-slate-200 text-slate-800 text-lg font-bold rounded-xl transition border border-slate-100" onclick="pressPinKey('8')">8</button>
<button class="py-3 bg-slate-50 hover:bg-slate-100 active:bg-slate-200 text-slate-800 text-lg font-bold rounded-xl transition border border-slate-100" onclick="pressPinKey('9')">9</button>
<button class="py-3 bg-slate-50 hover:bg-slate-100 text-slate-400 text-xs font-semibold rounded-xl" onclick="resetPinInput()">Clear</button>
<button class="py-3 bg-slate-50 hover:bg-slate-100 active:bg-slate-200 text-slate-800 text-lg font-bold rounded-xl transition border border-slate-100" onclick="pressPinKey('0')">0</button>
<button class="py-3 bg-slate-50 hover:bg-slate-100 active:bg-slate-200 text-slate-600 rounded-xl transition border border-slate-100" onclick="deletePinKey()"><i class="fa-solid fa-delete-left"></i></button>
</div>
</div>
</div>
<!-- ================= VIEW 1: STOREFRONT ================= -->
<section class="block" id="view-store">
<!-- Banner -->
<div class="p-4">
<div class="bg-gradient-to-r from-green-700 via-emerald-600 to-green-600 rounded-2xl p-4 text-white shadow-md relative overflow-hidden">
<span class="bg-white/20 text-white font-semibold text-[10px] uppercase px-2 py-0.5 rounded-full tracking-wider">Direct Farm Harvest</span>
<h2 class="text-lg font-black mt-1 leading-tight">Super Fresh Produce &amp; Daily Staples</h2>
<p class="text-xs text-green-100 mt-0.5">Free 20-min delivery on orders above ₹199</p>
<div class="mt-2.5 inline-flex items-center gap-1.5 bg-white text-green-800 text-xs font-bold px-3 py-1.5 rounded-xl shadow-xs">
          ⚡ 0% Fee UPI &amp; WhatsApp Ready <i class="fa-solid fa-bolt text-[10px]"></i>
</div>
</div>
</div>
<!-- Category Filter Pills -->
<div class="px-4 flex gap-2 overflow-x-auto no-scrollbar pb-2 text-xs font-semibold">
<button class="cat-pill bg-green-600 text-white px-3.5 py-1.5 rounded-full shrink-0 shadow-xs" onclick="setCategory('all')">All Items</button>
<button class="cat-pill bg-white text-slate-600 border border-slate-200 px-3.5 py-1.5 rounded-full shrink-0" onclick="setCategory('fruits')">🍎 Fruits &amp; Veggies</button>
<button class="cat-pill bg-white text-slate-600 border border-slate-200 px-3.5 py-1.5 rounded-full shrink-0" onclick="setCategory('staples')">🌾 Rice, Dal &amp; Staples</button>
<button class="cat-pill bg-white text-slate-600 border border-slate-200 px-3.5 py-1.5 rounded-full shrink-0" onclick="setCategory('baby')">👶 Baby Care</button>
<button class="cat-pill bg-white text-slate-600 border border-slate-200 px-3.5 py-1.5 rounded-full shrink-0" onclick="setCategory('toiletries')">🧼 Toiletries</button>
</div>
<!-- Products Grid -->
<main class="px-4 mt-2">
<div class="flex items-center justify-between mb-3">
<h3 class="font-extrabold text-slate-900 text-sm">Fresh Daily Catalog</h3>
<span class="text-[11px] font-semibold text-green-700"><i class="fa-solid fa-badge-check"></i> Best Market Rates</span>
</div>
<div class="grid grid-cols-2 gap-3 pb-8" id="productGrid">
<!-- Injected via JavaScript -->
</div>
</main>
</section>
<!-- ================= VIEW 2: BASKET ================= -->
<section class="hidden p-4" id="view-basket">
<div class="flex items-center justify-between mb-3">
<h2 class="text-base font-extrabold text-slate-900 flex items-center gap-2">
<i class="fa-solid fa-basket-shopping text-green-600"></i> Your Basket
      </h2>
<button class="text-xs text-red-500 font-semibold flex items-center gap-1" onclick="clearBasket()">
<i class="fa-solid fa-trash-can text-[10px]"></i> Clear
      </button>
</div>
<div class="space-y-3" id="basketItemsList">
<!-- Injected via JavaScript -->
</div>
<div class="hidden text-center py-16" id="emptyBasketNotice">
<div class="w-16 h-16 bg-green-50 rounded-full flex items-center justify-center text-green-600 text-2xl mx-auto mb-3">
<i class="fa-solid fa-basket-shopping"></i>
</div>
<h3 class="font-bold text-slate-800 text-sm">Your basket is empty</h3>
<p class="text-xs text-slate-400 mt-1 mb-4">Add crisp fruits, fresh veggies &amp; daily staples</p>
<button class="bg-green-600 text-white font-bold text-xs px-5 py-2.5 rounded-xl shadow-xs" onclick="switchView('store')">
        Browse Fresh Produce
      </button>
</div>
<!-- Bill Breakdown Card -->
<div class="mt-5 bg-white border border-slate-100 rounded-2xl p-4 shadow-xs" id="billCard">
<h3 class="font-extrabold text-slate-900 text-xs uppercase tracking-wider mb-3">Bill Breakdown</h3>
<div class="space-y-2 text-xs">
<div class="flex justify-between text-slate-600">
<span>Items Subtotal</span>
<span class="font-semibold text-slate-800" id="subtotalDisplay">₹0</span>
</div>
<div class="flex justify-between text-emerald-600">
<span>Fresh Discount (₹50 off &gt; ₹300)</span>
<span class="font-semibold" id="discountDisplay">-₹0</span>
</div>
<div class="flex justify-between text-slate-600">
<span>Delivery Partner Fee</span>
<span class="text-green-600 font-bold uppercase text-[10px] bg-green-50 px-1.5 py-0.5 rounded">FREE (Express)</span>
</div>
<div class="flex justify-between text-slate-600">
<span>Eco Packaging &amp; Handling</span>
<span class="font-semibold text-slate-800">₹6</span>
</div>
<div class="border-t border-slate-100 pt-2 flex justify-between text-sm font-extrabold text-slate-900">
<span>Total Payable</span>
<span class="text-green-700" id="totalDisplay">₹0</span>
</div>
</div>
</div>
<div class="mt-4" id="proceedCheckoutBtn">
<button class="w-full bg-green-600 hover:bg-green-700 text-white font-extrabold py-3.5 px-4 rounded-2xl shadow-lg flex items-center justify-between text-sm transition" onclick="switchView('checkout')">
<span id="basketPayAmount">Pay ₹0</span>
<span class="flex items-center gap-1.5">Proceed to Checkout <i class="fa-solid fa-arrow-right text-xs"></i></span>
</button>
</div>
</section>
<!-- ================= VIEW 3: CHECKOUT & PAYMENT ================= -->
<section class="hidden p-4 space-y-4" id="view-checkout">
<!-- Empty Cart Alert in Checkout if accessed empty -->
<div class="hidden bg-amber-50 border border-amber-200 rounded-2xl p-4 text-center" id="checkoutEmptyAlert">
<i class="fa-solid fa-basket-shopping text-amber-500 text-2xl mb-2"></i>
<h3 class="font-bold text-slate-800 text-sm">Your basket is currently empty</h3>
<p class="text-xs text-slate-500 mt-1 mb-3">Please add fresh groceries before proceeding with checkout.</p>
<button class="bg-green-600 text-white font-bold text-xs px-4 py-2 rounded-xl shadow-xs" onclick="switchView('store')">
        Explore Fresh Catalog
      </button>
</div>
<div class="space-y-4" id="checkoutContent">
<div class="flex items-center justify-between">
<h2 class="text-base font-extrabold text-slate-900 flex items-center gap-2">
<i class="fa-solid fa-shield-check text-green-600"></i> Checkout &amp; Delivery
        </h2>
<span class="text-[10px] font-bold text-emerald-700 bg-emerald-50 px-2 py-0.5 rounded-full border border-emerald-100">
          100% Safe
        </span>
</div>
<!-- Customer Address Details Card -->
<div class="bg-white border border-slate-100 rounded-2xl p-4 shadow-xs">
<div class="flex items-center justify-between mb-2">
<span class="text-xs font-bold text-slate-900 flex items-center gap-1.5">
<i class="fa-solid fa-house-chimney text-green-600"></i> Delivery Address
          </span>
<span class="text-[10px] font-semibold text-green-700 bg-green-50 px-2 py-0.5 rounded-full">Primary</span>
</div>
<input class="w-full text-xs font-bold text-slate-800 border-b border-slate-100 pb-1.5 focus:outline-none focus:border-green-500 mb-2" id="custName" placeholder="Enter your full name" type="text" value=""/>
<textarea class="w-full text-xs text-slate-600 border border-slate-100 rounded-xl p-2.5 focus:outline-none focus:ring-1 focus:ring-green-500" id="custAddress" placeholder="Flat / House No, Building, Landmark, Area, Pin code" rows="2"></textarea>
<input class="w-full text-xs text-slate-700 border border-slate-100 rounded-xl p-2.5 mt-2 focus:outline-none focus:ring-1 focus:ring-green-500" id="custPhone" placeholder="10-digit WhatsApp phone number" type="tel" value=""/>
</div>
<!-- UPI QR Code & Direct Pay Card -->
<div class="bg-gradient-to-br from-white to-green-50/50 border-2 border-green-500/30 rounded-2xl p-4 shadow-xs">
<div class="flex items-center justify-between mb-3">
<div class="flex items-center gap-2">
<div class="w-7 h-7 rounded-lg bg-green-600 text-white flex items-center justify-center text-xs">
<i class="fa-solid fa-qrcode"></i>
</div>
<div>
<h3 class="font-extrabold text-xs text-slate-900">Home Mart Official UPI</h3>
<p class="text-[10px] text-green-700 font-semibold">0% Surcharge • Scan &amp; Pay</p>
</div>
</div>
<span class="bg-green-600 text-white font-bold text-[9px] uppercase px-2 py-0.5 rounded-full">Official</span>
</div>
<div class="bg-white border border-green-200/80 rounded-xl p-3 flex items-center justify-between">
<div>
<div class="text-[10px] text-slate-400 font-medium">Store UPI ID</div>
<div class="text-xs font-extrabold text-slate-900 font-mono tracking-tight" id="upiIdDisplay">9082207857@ybl</div>
<div class="text-[10px] text-slate-500">Merchant: Home Mart Fresh Retail</div>
</div>
<button class="bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-bold px-3 py-1.5 rounded-lg flex items-center gap-1 transition" onclick="copyUpi()">
<i class="fa-regular fa-copy text-[10px]"></i> <span id="copyUpiLabel">Copy</span>
</button>
</div>
<div class="mt-3 flex items-center gap-3 text-[11px] text-slate-500">
<span class="flex items-center gap-1"><i class="fa-brands fa-google-pay text-base text-slate-700"></i> GPay</span>
<span class="flex items-center gap-1"><i class="fa-solid fa-bolt text-xs text-purple-600"></i> PhonePe</span>
<span class="flex items-center gap-1"><i class="fa-solid fa-wallet text-xs text-blue-600"></i> Paytm</span>
</div>
</div>
<!-- Payment Choice Radios -->
<div class="bg-white border border-slate-100 rounded-2xl p-4 shadow-xs space-y-2.5">
<h3 class="font-bold text-xs text-slate-900 mb-2">Select Payment Method</h3>
<label class="flex items-center justify-between p-2.5 border border-green-500 bg-green-50/40 rounded-xl cursor-pointer">
<div class="flex items-center gap-2.5">
<input checked="" class="text-green-600 focus:ring-green-500" name="payMethod" type="radio" value="UPI QR (9082207857@ybl)"/>
<div>
<div class="text-xs font-bold text-slate-800">Scan UPI QR / 9082207857@ybl</div>
<div class="text-[10px] text-slate-500">Fast UPI app transfer or WhatsApp screenshot</div>
</div>
</div>
<i class="fa-solid fa-circle-check text-green-600 text-sm"></i>
</label>
<label class="flex items-center justify-between p-2.5 border border-slate-200 rounded-xl cursor-pointer">
<div class="flex items-center gap-2.5">
<input class="text-green-600 focus:ring-green-500" name="payMethod" type="radio" value="Cash on Delivery (COD)"/>
<div>
<div class="text-xs font-bold text-slate-800">Cash on Delivery (COD)</div>
<div class="text-[10px] text-slate-500">Pay cash or rider QR upon receipt</div>
</div>
</div>
<i class="fa-solid fa-money-bill-wave text-slate-400 text-sm"></i>
</label>
</div>
<!-- 1-Tap Place WhatsApp Order CTA -->
<button class="w-full bg-green-700 hover:bg-green-800 text-white font-extrabold py-3.5 px-4 rounded-2xl shadow-xl flex items-center justify-between text-sm transition" onclick="placeWhatsAppOrder()">
<span id="checkoutTotalBtn">Pay ₹0</span>
<span class="flex items-center gap-2">Place Order on WhatsApp <i class="fa-brands fa-whatsapp text-base"></i></span>
</button>
</div>
</section>
<!-- ================= VIEW 4: RECEIPT & LIVE TRACKING ================= -->
<section class="hidden p-4 space-y-4" id="view-receipt">
<!-- Active Tracking Banner from WhatsApp Link -->
<div class="hidden bg-emerald-50 border border-emerald-200 text-emerald-800 rounded-2xl p-3 flex items-center gap-2.5 text-xs font-bold shadow-xs" id="liveTrackingActiveBanner">
<span class="w-2.5 h-2.5 rounded-full bg-emerald-500 animate-ping"></span>
<span>Live Order Tracking active via WhatsApp link</span>
</div>
<div class="text-center pt-2">
<div class="w-16 h-16 bg-green-100 text-green-600 rounded-full flex items-center justify-center text-2xl mx-auto shadow-inner">
<i class="fa-solid fa-circle-check"></i>
</div>
<span class="inline-block bg-green-100 text-green-800 font-bold text-[10px] px-2.5 py-0.5 rounded-full mt-2 uppercase tracking-wide">
        ● WhatsApp Order Synced
      </span>
<h2 class="text-xl font-extrabold text-slate-900 mt-1">Order Confirmed!</h2>
<p class="text-xs text-slate-500 font-mono mt-0.5 font-bold" id="receiptOrderId">Order #HM-84920</p>
</div>
<!-- Live ETA Tracker -->
<div class="bg-white border border-slate-100 rounded-2xl p-4 shadow-xs">
<div class="flex items-center justify-between mb-3">
<div>
<div class="text-[11px] text-slate-400 font-medium">Estimated Arrival</div>
<div class="text-base font-extrabold text-slate-900 flex items-center gap-1.5">
<span class="text-green-600">Arriving in 18–22 mins</span>
