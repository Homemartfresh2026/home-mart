    function handleCreateNotification(e) {
      e.preventDefault();
      const title = document.getElementById('notifTitle').value.trim();
      const message = document.getElementById('notifMessage').value.trim();
      const type = document.getElementById('notifType').value;
      const emoji = document.getElementById('notifEmoji').value.trim() || '📢';
      const expiry = document.getElementById('notifExpiry').value.trim() || 'Active today';
      const isTopBanner = document.getElementById('notifShowBanner').checked;

      if (!title || !message) {
        alert("Please provide both title and details for the announcement.");
        return;
      }

      // If set as top banner, unpin previous banners to keep only 1 pinned banner clean
      if (isTopBanner) {
        notifications.forEach(n => { n.isTopBanner = false; });
      }

      const newBroadcast = {
        id: Date.now(),
        title,
        message,
        type,
        emoji,
        expiry,
        isTopBanner,
        isActive: true,
        timestamp: Date.now()
      };

      notifications.unshift(newBroadcast);
      isBannerDismissedSession = false; // Reset dismissal on new alert
      saveNotifications();

      // Reset form
      document.getElementById('broadcastForm').reset();
      document.getElementById('notifEmoji').value = "⚡";
      document.getElementById('notifExpiry').value = "Valid today only";
      document.getElementById('notifShowBanner').checked = true;

      alert(`Published! "${title}" is now live for all store visitors.`);
    }

    function toggleNotificationStatus(id) {
      const target = notifications.find(n => n.id == id);
      if (target) {
        target.isActive = !target.isActive;
        saveNotifications();
      }
    }

    function toggleNotificationBanner(id) {
      const target = notifications.find(n => n.id == id);
      if (target) {
        const nextState = !target.isTopBanner;
        if (nextState) {
          // Unpin others
          notifications.forEach(n => { n.isTopBanner = false; });
          target.isTopBanner = true;
          isBannerDismissedSession = false;
        } else {
          target.isTopBanner = false;
        }
        saveNotifications();
      }
    }

    function deleteNotification(id) {
      if (confirm("Permanently delete this announcement from store records?")) {
        notifications = notifications.filter(n => n.id != id);
        saveNotifications();
      }
    }

    function seedSampleNotifications() {
      if (confirm("Reset notifications back to default templates?")) {
        notifications = JSON.parse(JSON.stringify(defaultNotifications));
        isBannerDismissedSession = false;
        saveNotifications();
      }
    }

    function triggerWhatsAppGroupBroadcast() {
      const activeList = notifications.filter(n => n.isActive !== false);
      let textLines = "";
      if (activeList.length > 0) {
        activeList.slice(0, 3).forEach(n => {
          textLines += `${n.emoji} *${n.title}*\n${n.message}\n\n`;
        });
      } else {
        textLines = `⚡ Fresh batch of farm fruits, vegetables & pulses arrived today at Home Mart Fresh!\n\n`;
      }

      const storeLink = window.location.href.split('?')[0];
      const msg = `📢 *HOME MART FRESH — STORE ANNOUNCEMENT*\n\n` +
                  `${textLines}` +
                  `🛒 *Order Express 20-min Delivery here:* ${storeLink}\n` +
                  `⚡ *Instant WhatsApp Orders:* +91 7006934064\n` +
                  `UPI: 9082207857@ybl (0% Fee)`;

      const waUrl = `https://api.whatsapp.com/send?text=${encodeURIComponent(msg)}`;
      window.open(waUrl, '_blank');
    }

    // ================= PIN AUTH & ADMIN CONTROLS =================
    function openAdminAuthModal() {
      if (isAdminAuthenticated) {
        switchView('admin');
        return;
      }
      resetPinInput();
      document.getElementById('pinErrorMessage').classList.add('hidden');
      document.getElementById('adminAuthModal').classList.remove('hidden');
    }

    function closeAdminAuthModal() {
      document.getElementById('adminAuthModal').classList.add('hidden');
      resetPinInput();
    }

    function updatePinDots() {
      const dots = document.querySelectorAll('#pinDotsWrapper .pin-dot');
      dots.forEach((dot, index) => {
        if (index < enteredPin.length) {
          dot.className = "pin-dot w-3.5 h-3.5 rounded-full border-2 border-green-600 bg-green-600 transition-all scale-110 shadow-xs";
        } else {
          dot.className = "pin-dot w-3.5 h-3.5 rounded-full border-2 border-slate-300 bg-slate-100 transition-all";
        }
      });
    }

    function pressPinKey(digit) {
      if (enteredPin.length < 4) {
        enteredPin += digit;
        updatePinDots();
        document.getElementById('pinErrorMessage').classList.add('hidden');
        if (enteredPin.length === 4) {
          setTimeout(verifyPin, 150);
        }
      }
    }

    function deletePinKey() {
      if (enteredPin.length > 0) {
        enteredPin = enteredPin.slice(0, -1);
        updatePinDots();
        document.getElementById('pinErrorMessage').classList.add('hidden');
      }
    }

    function resetPinInput() {
      enteredPin = "";
      updatePinDots();
    }

    function verifyPin() {
      const currentPin = getStoredPin();
      if (enteredPin === currentPin) {
        isAdminAuthenticated = true;
        closeAdminAuthModal();
        switchView('admin');
      } else {
        document.getElementById('pinErrorMessage').classList.remove('hidden');
        const dots = document.querySelectorAll('#pinDotsWrapper .pin-dot');
        dots.forEach(dot => {
          dot.className = "pin-dot w-3.5 h-3.5 rounded-full border-2 border-rose-500 bg-rose-500 transition-all";
        });
        setTimeout(resetPinInput, 700);
      }
    }

    function exitAdminPanel() {
      isAdminAuthenticated = false;
      switchView('store');
    }

    function renderAdminDashboard() {
      document.getElementById('adminTotalItemsCount').innerText = products.length;
      const inStockCount = products.filter(p => p.inStock !== false).length;
      document.getElementById('adminInStockCount').innerText = `${inStockCount} In Stock • ${products.length - inStockCount} Sold Out`;
      renderAdminProductList();
      renderNotifications();
      if (adminSubTab === 'broadcasts') {
        renderAdminBroadcastList();
      }
    }

    function renderAdminProductList() {
      const filterText = (document.getElementById('adminSearchInput')?.value || '').toLowerCase();
      const filterCat = document.getElementById('adminCategoryFilter')?.value || 'all';
      const container = document.getElementById('adminProductCardsList');
      if (!container) return;
      container.innerHTML = '';

      const filtered = products.filter(p => {
        const matchesCat = filterCat === 'all' || p.cat === filterCat;
        const matchesSearch = p.name.toLowerCase().includes(filterText) || (p.tag || '').toLowerCase().includes(filterText);
        return matchesCat && matchesSearch;
      });

      if (filtered.length === 0) {
        container.innerHTML = `<div class="p-6 text-center text-xs text-slate-400">No matching products found in catalog.</div>`;
        return;
      }

      filtered.forEach(p => {
        const isStocked = p.inStock !== false;
        const row = document.createElement('div');
        row.className = "bg-slate-50/70 border border-slate-200/80 rounded-xl p-3 flex flex-col md:flex-row md:items-center justify-between gap-3";
        row.innerHTML = `
          <div class="flex items-center gap-3">
            <span class="text-2xl">${p.emoji || '🥑'}</span>
            <div>
              <div class="flex items-center gap-2">
                <span class="font-bold text-xs text-slate-900">${p.name}</span>
                <span class="text-[9px] uppercase px-1.5 py-0.5 rounded font-semibold ${isStocked ? 'bg-emerald-100 text-emerald-800' : 'bg-rose-100 text-rose-800'}">
                  ${isStocked ? 'In Stock' : 'Sold Out'}
                </span>
              </div>
              <div class="text-[10px] text-slate-500 mt-0.5">${p.unit} • Category: <span class="capitalize font-semibold text-slate-600">${p.cat}</span></div>
            </div>
          </div>

          <div class="flex flex-wrap items-center gap-2.5">
            <!-- Price Editor -->
            <div class="flex items-center gap-1.5 bg-white border border-slate-200 rounded-lg px-2 py-1">
              <span class="text-[10px] text-slate-400 font-bold">Sell ₹</span>
              <input type="number" min="1" value="${p.price}" onchange="updateProductRate(${p.id}, 'price', this.value)" class="w-14 text-xs font-bold text-slate-900 p-0 border-0 focus:ring-0 bg-transparent text-right" />
            </div>

            <!-- MRP Editor -->
            <div class="flex items-center gap-1.5 bg-white border border-slate-200 rounded-lg px-2 py-1">
              <span class="text-[10px] text-slate-400 font-bold">MRP ₹</span>
              <input type="number" min="1" value="${p.strike || p.price}" onchange="updateProductRate(${p.id}, 'strike', this.value)" class="w-14 text-xs text-slate-500 p-0 border-0 focus:ring-0 bg-transparent text-right line-through" />
            </div>

            <!-- Toggle Stock -->
            <button onclick="toggleProductStock(${p.id})" class="px-2.5 py-1.5 rounded-lg text-xs font-bold transition flex items-center gap-1 ${isStocked ? 'bg-amber-100 text-amber-800 hover:bg-amber-200' : 'bg-emerald-100 text-emerald-800 hover:bg-emerald-200'}">
              <i class="fa-solid ${isStocked ? 'fa-ban' : 'fa-check'} text-[10px]"></i>
              ${isStocked ? 'Mark Out' : 'Mark Stocked'}
            </button>

            <!-- Delete Item -->
            <button onclick="deleteProduct(${p.id})" class="w-8 h-8 rounded-lg bg-rose-50 text-rose-600 hover:bg-rose-100 flex items-center justify-center text-xs transition" title="Delete Product">
              <i class="fa-solid fa-trash-can"></i>
            </button>
          </div>
        `;
        container.appendChild(row);
      });
    }

    function updateProductRate(id, key, val) {
      const numVal = parseInt(val, 10);
      if (isNaN(numVal) || numVal < 0) return;
      const target = products.find(p => p.id == id);
      if (target) {
        target[key] = numVal;
        saveProducts();
      }
    }

    function toggleProductStock(id) {
      const target = products.find(p => p.id == id);
      if (target) {
        target.inStock = !(target.inStock !== false);
        if (!target.inStock && cart[id]) {
          delete cart[id];
          saveCart();
        }
        saveProducts();
      }
    }

    function deleteProduct(id) {
      if (confirm("Are you sure you want to delete this product from the live catalog?")) {
        products = products.filter(p => p.id != id);
        if (cart[id]) {
          delete cart[id];
          saveCart();
        }
        saveProducts();
      }
    }

    function toggleAddProductForm() {
      const form = document.getElementById('newProductForm');
      const icon = document.getElementById('addProductToggleIcon');
      if (form.classList.contains('hidden')) {
        form.classList.remove('hidden');
        icon.innerHTML = '<i class="fa-solid fa-chevron-up"></i>';
      } else {
        form.classList.add('hidden');
        icon.innerHTML = '<i class="fa-solid fa-chevron-down"></i>';
      }
    }

    function handleAddNewProduct(e) {
      e.preventDefault();
      const name = document.getElementById('newProdName').value.trim();
      const cat = document.getElementById('newProdCat').value;
      const unit = document.getElementById('newProdUnit').value.trim();
      const price = parseInt(document.getElementById('newProdPrice').value, 10);
      const strike = parseInt(document.getElementById('newProdStrike').value, 10);
      const emoji = document.getElementById('newProdEmoji').value.trim() || '🛒';
      const tag = document.getElementById('newProdTag').value.trim() || 'Fresh Harvest';

      if (!name || isNaN(price)) {
        alert("Please enter a valid product name and price.");
        return;
      }

      const newId = Date.now();
      const newProduct = {
        id: newId,
        name,
        cat,
        unit,
        price,
        strike: strike || Math.round(price * 1.2),
        emoji,
        tag,
        inStock: true
      };

      products.unshift(newProduct);
      saveProducts();

      // Reset form
      document.getElementById('newProductForm').reset();
      document.getElementById('newProdEmoji').value = "🥭";
      document.getElementById('newProdTag').value = "Fresh Picked";
      alert(`Success! "${name}" added to live catalog.`);
    }

    function changeAdminPin() {
      const newPin = document.getElementById('newAdminPinInput').value.trim();
      if (!/^\d{4}$/.test(newPin)) {
        alert("Admin PIN must be exactly 4 digits (0-9).");
        return;
      }
      localStorage.setItem('hm_admin_pin', newPin);
      document.getElementById('newAdminPinInput').value = '';
      const msg = document.getElementById('pinUpdateSuccessMsg');
      msg.classList.remove('hidden');
      setTimeout(() => msg.classList.add('hidden'), 3500);
    }

    function resetDefaultProductsPrompt() {
      if (confirm("Restore original demo catalog? (Custom items will be replaced)")) {
        products = JSON.parse(JSON.stringify(defaultProducts));
        saveProducts();
        alert("Catalog restored to defaults!");
      }
    }

    function copyUpi() {
      navigator.clipboard.writeText(STORE_UPI);
      const label = document.getElementById('copyUpiLabel');
      label.innerText = "Copied!";
      setTimeout(() => { label.innerText = "Copy"; }, 2000);
    }

    function getTrackingUrl(orderId) {
      const origin = window.location.origin || window.location.protocol + "//" + window.location.host;
      const pathname = window.location.pathname || "";
      return `${origin}${pathname}?track=${encodeURIComponent(orderId)}`;
    }

    function copyTrackingUrl() {
      const orderId = currentActiveOrderId || (JSON.parse(localStorage.getItem('hm_active_order') || '{}').orderId) || "HM-84920";
      const url = getTrackingUrl(orderId);
      navigator.clipboard.writeText(url);
      const label = document.getElementById('copyTrackBtnLabel');
      label.innerText = "Copied!";
      setTimeout(() => { label.innerText = "Copy"; }, 2000);
    }

    function shareTrackingWhatsApp() {
      const orderId = currentActiveOrderId || (JSON.parse(localStorage.getItem('hm_active_order') || '{}').orderId) || "HM-84920";
      const trackUrl = getTrackingUrl(orderId);
      const msg = `📦 Track my Home Mart order *#${orderId}* live here:\n${trackUrl}`;
      const waUrl = `https://api.whatsapp.com/send?text=${encodeURIComponent(msg)}`;
      window.open(waUrl, '_blank');
    }

    function placeWhatsAppOrder() {
      const { count, total } = calculateTotals();
      if (count === 0) {
        alert("Your basket is empty. Please add items to proceed!");
        switchView('store');
        return;
      }

      const name = document.getElementById('custName').value.trim() || "Customer";
      const address = document.getElementById('custAddress').value.trim() || "Address not provided";
      const phone = document.getElementById('custPhone').value.trim() || "+91 7006934064";
      const method = document.querySelector('input[name="payMethod"]:checked')?.value || "UPI QR (9082207857@ybl)";
      const orderId = 'HM-' + Math.floor(10000 + Math.random() * 90000);
      currentActiveOrderId = orderId;

      let itemList = "";
      for (const [id, qty] of Object.entries(cart)) {
        const item = products.find(p => p.id == id);
        if (item && qty > 0) {
          itemList += `• ${item.name} (${item.unit}) x ${qty} = ₹${item.price * qty}\n`;
        }
      }

      const trackUrl = getTrackingUrl(orderId);

      localStorage.setItem('hm_active_order', JSON.stringify({
        orderId,
        name,
        address,
        phone,
        total,
        itemList,
        time: Date.now()
      }));

      const msg = `🛒 *NEW ORDER: HOME MART FRESH*\n` +
                  `Order ID: *#${orderId}*\n\n` +
                  `👤 *Customer:* ${name}\n` +
                  `📞 *Phone:* ${phone}\n` +
                  `📍 *Delivery Address:* ${address}\n\n` +
                  `📦 *Order Items:*\n${itemList}\n` +
                  `💰 *Total Amount:* ₹${total}\n` +
                  `💳 *Payment:* ${method}\n` +
                  `⚡ *Official UPI:* ${STORE_UPI}\n` +
                  `📍 *Track Live Order Status:* ${trackUrl}\n\n` +
                  `_Please confirm packing and delivery partner dispatch!_`;

      document.getElementById('receiptOrderId').innerText = `Order #${orderId}`;

      const waUrl = `https://api.whatsapp.com/send?phone=${STORE_WHATSAPP}&text=${encodeURIComponent(msg)}`;
      window.open(waUrl, '_blank');

      cart = {};
      saveCart();

      switchView('receipt');
    }

    function checkUrlTracking() {
      const urlParams = new URLSearchParams(window.location.search);
      const trackId = urlParams.get('track') || urlParams.get('order');
      if (trackId) {
        currentActiveOrderId = trackId;
        document.getElementById('receiptOrderId').innerText = `Order #${trackId}`;
        const banner = document.getElementById('liveTrackingActiveBanner');
        if (banner) banner.classList.remove('hidden');
        switchView('receipt');
        return true;
      }
      return false;
    }

    // Support keyboard numeric inputs when modal is visible
    document.addEventListener('keydown', (e) => {
      const authModal = document.getElementById('adminAuthModal');
      if (authModal && !authModal.classList.contains('hidden')) {
        if (e.key >= '0' && e.key <= '9') {
          pressPinKey(e.key);
        } else if (e.key === 'Backspace') {
          deletePinKey();
        } else if (e.key === 'Escape') {
          closeAdminAuthModal();
        }
      }
    });

    renderStorefront();
    renderNotifications();
    renderStoreBanner();
    updateCartCounts();
    checkUrlTracking();
  </script>
</body></html>
