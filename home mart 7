  function copyUPI() {
    navigator.clipboard.writeText(storeUpi).then(() => {
      showToast('UPI Copied: ' + storeUpi);
    }).catch(() => {
      showToast('UPI ID: ' + storeUpi);
    });
  }
  if (copyUpiTopBtn) copyUpiTopBtn.addEventListener('click', copyUPI);
  if (copyDrawerUpiBtn) copyDrawerUpiBtn.addEventListener('click', copyUPI);

  // Update Cart UI
  function updateCartUI() {
    let totalItems = 0;
    let totalPrice = 0;
    let totalMrp = 0;

    Object.values(cart).forEach(item => {
      if (item.qty > 0) {
        totalItems += item.qty;
        totalPrice += item.price * item.qty;
        totalMrp += item.mrp * item.qty;
      }
    });

    if (totalItems > 0) {
      floatingCartBar.classList.remove('translate-y-36');
      floatingCartBar.classList.add('translate-y-0');
      floatingCartCountBadge.textContent = totalItems;
      floatingCartTotal.textContent = '₹' + totalPrice;
      floatingCartMrp.textContent = '₹' + (totalMrp || totalPrice + 90);
    } else {
      floatingCartBar.classList.remove('translate-y-0');
      floatingCartBar.classList.add('translate-y-36');
    }

    cartDrawerCount.textContent = totalItems;
    billSubtotal.textContent = '₹' + totalPrice;
    billGrandTotal.textContent = '₹' + Math.max(0, (totalPrice + 6 - 50));

    // Render Drawer List
    cartItemList.innerHTML = '';
    if (totalItems === 0) {
      cartItemList.innerHTML = `<div class="py-8 text-center text-on-surface-variant font-body-md">Your fresh basket is empty. Add crisp apples or veggies!</div>`;
    } else {
      Object.values(cart).forEach(item => {
        if (item.qty > 0) {
          const row = document.createElement('div');
          row.className = 'flex items-center justify-between bg-surface-container-lowest p-space-sm rounded-xl shadow-sm';
          row.innerHTML = `
            <div class="flex flex-col min-w-0 pr-2">
              <span class="font-title-sm text-title-sm font-bold text-on-surface truncate">${item.name}</span>
              <span class="font-body-sm text-body-sm text-on-surface-variant">${item.weight} • ₹${item.price} each</span>
            </div>
            <div class="flex items-center gap-2 bg-surface-container px-2 py-1 rounded-lg">
              <button class="drawer-qty-minus text-on-surface font-extrabold w-6 h-6 flex items-center justify-center rounded hover:bg-surface-container-highest" data-id="${item.id}">−</button>
              <span class="font-label-md text-label-md font-bold px-1">${item.qty}</span>
              <button class="drawer-qty-plus text-primary font-extrabold w-6 h-6 flex items-center justify-center rounded hover:bg-surface-container-highest" data-id="${item.id}">+</button>
            </div>
          `;
          cartItemList.appendChild(row);
        }
      });
    }

    // Sync Product Card Steppers
    document.querySelectorAll('.product-item').forEach(card => {
      const pid = card.getAttribute('data-id');
      const container = card.querySelector('.action-btn-container');
      const curItem = cart[pid];

      if (curItem && curItem.qty > 0) {
        container.innerHTML = `
          <div class="inline-flex items-center bg-primary text-on-primary rounded-lg px-1.5 py-1 shadow-sm gap-1.5">
            <button class="card-step-minus w-5 h-5 flex items-center justify-center font-bold text-on-primary hover:bg-primary-container rounded" data-id="${pid}">−</button>
            <span class="font-label-md text-label-md font-extrabold px-1 text-on-primary">${curItem.qty}</span>
            <button class="card-step-plus w-5 h-5 flex items-center justify-center font-bold text-on-primary hover:bg-primary-container rounded" data-id="${pid}">+</button>
          </div>
        `;
      } else {
        container.innerHTML = `
          <button class="add-btn bg-surface-container-lowest text-primary font-label-sm text-label-sm font-extrabold px-3.5 py-1.5 rounded-lg shadow-sm hover:bg-primary hover:text-on-primary transition-all">
            + ADD
          </button>
        `;
      }
    });

    attachItemListeners();
  }

  function attachItemListeners() {
    // Add Buttons on product cards
    document.querySelectorAll('.add-btn').forEach(btn => {
      btn.onclick = (e) => {
        const card = e.target.closest('.product-item');
        const id = card.getAttribute('data-id');
        const name = card.getAttribute('data-name');
        const price = parseFloat(card.getAttribute('data-price'));
        const weight = card.getAttribute('data-weight');

        cart[id] = { id, name, price, mrp: Math.round(price * 1.25), qty: 1, weight };
        showToast(`Added ${name} to basket!`);
        updateCartUI();
      };
    });

    // Plus/Minus inside card steppers
    document.querySelectorAll('.card-step-plus').forEach(btn => {
      btn.onclick = (e) => {
        const id = e.target.getAttribute('data-id');
        if (cart[id]) cart[id].qty++;
        updateCartUI();
      };
    });
    document.querySelectorAll('.card-step-minus').forEach(btn => {
      btn.onclick = (e) => {
        const id = e.target.getAttribute('data-id');
        if (cart[id]) {
          cart[id].qty--;
          if (cart[id].qty <= 0) delete cart[id];
        }
        updateCartUI();
      };
    });

    // Plus/Minus inside drawer
    document.querySelectorAll('.drawer-qty-plus').forEach(btn => {
      btn.onclick = (e) => {
        const id = e.target.getAttribute('data-id');
        if (cart[id]) cart[id].qty++;
        updateCartUI();
      };
    });
    document.querySelectorAll('.drawer-qty-minus').forEach(btn => {
      btn.onclick = (e) => {
        const id = e.target.getAttribute('data-id');
        if (cart[id]) {
          cart[id].qty--;
          if (cart[id].qty <= 0) delete cart[id];
        }
        updateCartUI();
      };
    });
  }

  // Drawer Open/Close
  if (openCartDrawerBtn) {
    openCartDrawerBtn.addEventListener('click', () => cartDrawer.classList.remove('hidden'));
  }
  if (closeCartDrawerBtn) {
    closeCartDrawerBtn.addEventListener('click', () => cartDrawer.classList.add('hidden'));
  }

  // 1-Tap WhatsApp Trigger
  if (whatsappOrderBtn) {
    whatsappOrderBtn.addEventListener('click', () => {
      const itemsList = Object.values(cart)
        .filter(i => i.qty > 0)
        .map(i => `• ${i.name} (${i.weight}) x ${i.qty} = ₹${i.price * i.qty}`)
        .join('%0A');
      
      const totalAmount = billGrandTotal.textContent;
      const text = `*New Order - Home Mart FRESH (Indiranagar)*%0A%0A${itemsList}%0A%0A*Total To Pay:* ${totalAmount}%0A*Delivery to:* Flat 302, Green Glen Layout, Indiranagar%0A*Customer:* Vikas S. (+91 98845 21098)%0A*Paid via:* UPI (9082207857@ybl)`;
      
      window.open(`https://wa.me/917006934064?text=${text}`, '_blank');
    });
  }

  // PIN Admin Modal Logic
  pinInputs.forEach((input, index) => {
    input.addEventListener('input', (e) => {
      if (e.target.value.length === 1 && index < pinInputs.length - 1) {
        pinInputs[index + 1].focus();
      }
    });
    input.addEventListener('keydown', (e) => {
      if (e.key === 'Backspace' && !e.target.value && index > 0) {
        pinInputs[index - 1].focus();
      }
    });
  });

  if (verifyAdminPinBtn) {
    verifyAdminPinBtn.addEventListener('click', () => {
      const enteredPin = Array.from(pinInputs).map(inp => inp.value).join('');
      if (enteredPin === '7006') {
        pinErrorMsg.classList.add('hidden');
        adminPinModal.classList.add('hidden');
        adminDeskDrawer.classList.remove('hidden');
        pinInputs.forEach(i => i.value = '');
        showToast('Admin Desk Authenticated');
      } else {
        pinErrorMsg.classList.remove('hidden');
        pinInputs.forEach(i => i.value = '');
        pinInputs[0].focus();
      }
    });
  }

  if (cancelAdminPinBtn) {
    cancelAdminPinBtn.addEventListener('click', () => {
      adminPinModal.classList.add('hidden');
      pinErrorMsg.classList.add('hidden');
      pinInputs.forEach(i => i.value = '');
    });
  }

  if (closeAdminDeskBtn) {
    closeAdminDeskBtn.addEventListener('click', () => {
      adminDeskDrawer.classList.add('hidden');
    });
  }

  // Category Tab Filter
  document.querySelectorAll('.filter-tab').forEach(tab => {
    tab.addEventListener('click', (e) => {
      document.querySelectorAll('.filter-tab').forEach(t => {
        t.classList.remove('bg-primary', 'text-on-primary');
        t.classList.add('bg-surface-container', 'text-on-surface');
      });
      tab.classList.add('bg-primary', 'text-on-primary');
      tab.classList.remove('bg-surface-container', 'text-on-surface');

      const filter = tab.getAttribute('data-filter');
      document.querySelectorAll('.product-item').forEach(item => {
        if (filter === 'all' || item.getAttribute('data-cat') === filter) {
          item.classList.remove('hidden');
        } else {
          item.classList.add('hidden');
        }
      });
    });
  });

  // Circular Category Chips Filter
  document.querySelectorAll('.cat-chip').forEach(chip => {
    chip.addEventListener('click', () => {
      const cat = chip.getAttribute('data-category');
      showToast(`Browsing ${chip.querySelector('span:nth-child(2)').textContent}`);
      document.querySelectorAll('.product-item').forEach(item => {
        if (item.getAttribute('data-cat') === cat || cat === 'vegetables' && item.getAttribute('data-cat') === 'vegetables') {
          item.classList.remove('hidden');
        } else {
          item.classList.add('hidden');
        }
      });
    });
  });

  // Countdown Timer
  let secondsRemaining = 2 * 3600 + 45 * 60 + 18;
  const countdownEl = document.getElementById('harvestCountdown');
  setInterval(() => {
    if (secondsRemaining > 0) {
      secondsRemaining--;
      const h = String(Math.floor(secondsRemaining / 3600)).padStart(2, '0');
      const m = String(Math.floor((secondsRemaining % 3600) / 60)).padStart(2, '0');
      const s = String(secondsRemaining % 60).padStart(2, '0');
      if (countdownEl) countdownEl.textContent = `${h}h ${m}m ${s}s`;
    }
  }, 1000);

  // Initialize
  updateCartUI();
</script></main><nav class="fixed bottom-0 w-full z-50 pb-safe bg-surface/90 backdrop-blur-xl shadow-[0_-4px_20px_-4px_rgba(15,23,42,0.08)]" data-active-classes="text-primary font-bold"><div class="flex justify-around items-center h-16 px-space-xs"><a aria-current="page" class="flex flex-col items-center justify-center gap-0.5 min-w-[56px] min-h-[44px] transition-colors text-primary font-bold" data-path="home-market" href="#"><span class="material-symbols-outlined text-[22px]">storefront</span><span class="font-label-sm text-label-sm">Market</span></a><a class="flex flex-col items-center justify-center gap-0.5 min-w-[56px] min-h-[44px] text-on-surface-variant transition-colors" data-path="categories" href="#"><span class="material-symbols-outlined text-[22px]">category</span><span class="font-label-sm text-label-sm">Categories</span></a><a class="flex flex-col items-center justify-center gap-0.5 min-w-[56px] min-h-[44px] text-on-surface-variant transition-colors relative" data-path="offers" href="#"><div class="relative flex items-center justify-center"><span class="material-symbols-outlined text-[22px]">local_offer</span><span class="absolute -top-1 -right-2 bg-error text-on-error font-label-sm text-[9px] px-1 rounded-full font-bold leading-none py-0.5">%</span></div><span class="font-label-sm text-label-sm">Offers</span></a><a class="flex flex-col items-center justify-center gap-0.5 min-w-[56px] min-h-[44px] text-on-surface-variant transition-colors relative" data-path="orders" href="#"><div class="relative flex items-center justify-center"><span class="material-symbols-outlined text-[22px]">receipt_long</span><span class="absolute -top-1 -right-2 bg-secondary text-on-secondary font-label-sm text-[9px] px-1 rounded-full font-bold leading-none py-0.5">2</span></div><span class="font-label-sm text-label-sm">Orders</span></a><a class="flex flex-col items-center justify-center gap-0.5 min-w-[56px] min-h-[44px] text-on-surface-variant transition-colors" data-path="admi